{
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": "apps/studio/**/*.{ts,tsx,js,jsx,json}",
      "options": {
        "singleQuote": true,
        "semi": false,
        "bracketSpacing": false,
        "printWidth": 100
      }
    }
  ]
}
