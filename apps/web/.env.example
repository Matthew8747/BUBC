# Copy this to .env (gitignored) for local dev.
# On Vercel, set the same vars in the project's Environment Variables UI.

# Sanity content fetching
SANITY_PROJECT_ID=j7zcx618
SANITY_DATASET=production
# Optional — write token for preview / draft mode (read tokens not needed for public published content)
# SANITY_API_READ_TOKEN=

# Formspree form IDs (anything prefixed PUBLIC_ is exposed to the client bundle)
PUBLIC_FORMSPREE_TRIAL_ID=

# Cloudflare Web Analytics beacon token (optional; if set, beacon is injected)
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Buttondown newsletter — your Buttondown username (the part before .buttondown.email).
# Newsletter form renders a "not configured" notice when unset.
PUBLIC_BUTTONDOWN_USERNAME=

# Sentry browser DSN (optional). Without it Sentry is a no-op at runtime.
PUBLIC_SENTRY_DSN=
