{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/squads/index.html",
        "http://localhost/squads/trial/index.html",
        "http://localhost/news/index.html",
        "http://localhost/alumni/index.html",
        "http://localhost/about/henley-honours/index.html",
        "http://localhost/about/olympians/index.html",
        "http://localhost/support/donate/index.html",
        "http://localhost/support/campaigns/index.html",
        "http://localhost/boathouse/fleet/index.html",
        "http://localhost/results/index.html",
        "http://localhost/press/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "uses-text-compression": "off",
        "uses-http2": "off",
        "is-on-https": "off",
        "redirects-http": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
