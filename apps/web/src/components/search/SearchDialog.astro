---
/**
 * SearchDialog — site-wide search modal powered by Pagefind.
 *
 * Pagefind generates a static search index at build time (run via `pnpm
 * pagefind` after `astro build`). At runtime, this component loads the
 * Pagefind ESM bundle from `/pagefind/pagefind.js` the first time the dialog
 * opens, then runs queries against the index entirely client-side. No server.
 *
 * Activation:
 *   - "/" key anywhere on the page (unless the user is already typing).
 *   - Cmd/Ctrl + K.
 *   - Clicking the magnifying-glass button in the Header.
 *
 * Accessibility:
 *   - Dialog has role="dialog" + aria-modal. Restores focus on close.
 *   - Results list is a navigable <ul>; up/down arrows move between rows,
 *     Enter follows the focused row. ESC closes.
 *   - aria-live region announces result counts to screen readers.
 *
 * Graceful degradation:
 *   - If pagefind.js is missing (dev server, build failed), we surface a
 *     polite "search is currently unavailable" message instead of breaking.
 */
---

<div
  id="search-dialog"
  class="fixed inset-0 z-[60] hidden items-start justify-center bg-[--color-ink]/60 backdrop-blur-sm p-4 pt-[10vh]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-title"
  aria-hidden="true"
>
  <div
    class="w-full max-w-2xl rounded bg-[--color-paper] shadow-2xl ring-1 ring-[--color-line] overflow-hidden flex flex-col max-h-[80vh]"
  >
    <div class="flex items-center gap-3 border-b border-[--color-line] px-5 py-3">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16Zm10 2-4.35-4.35"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <label class="sr-only" for="search-input" id="search-title">Search the site</label>
      <input
        id="search-input"
        type="search"
        placeholder="Search news, squads, athletes, boats…"
        autocomplete="off"
        class="flex-1 bg-transparent text-base outline-none placeholder:text-[--color-mute]"
      />
      <kbd
        class="hidden sm:inline-flex h-6 items-center rounded border border-[--color-line] px-2 text-xs font-mono text-[--color-mute]"
        aria-label="Press Escape to close">esc</kbd
      >
      <button
        id="search-close"
        type="button"
        class="inline-flex h-8 w-8 sm:hidden items-center justify-center"
        aria-label="Close search"
      >
        <svg width="16" height="16" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path
            d="M5 5l12 12M17 5L5 17"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto">
      <p id="search-empty" class="px-5 py-12 text-center text-sm text-[--color-mute]">
        Start typing to search news, squads, athletes, boats…
      </p>
      <p id="search-no-results" class="hidden px-5 py-12 text-center text-sm text-[--color-mute]">
        Nothing matched. Try a broader term or check the
        <a href="/news/" class="underline">news index</a>.
      </p>
      <p id="search-unavailable" class="hidden px-5 py-12 text-center text-sm text-[--color-mute]">
        Search isn't available right now — the index isn't built. Try the
        <a href="/news/" class="underline">news index</a> in the meantime.
      </p>
      <ul id="search-results" role="listbox" class="divide-y divide-[--color-line]"></ul>
    </div>

    <div
      class="border-t border-[--color-line] px-5 py-2 text-xs text-[--color-mute] flex items-center justify-between"
    >
      <span aria-live="polite" id="search-status"></span>
      <span class="hidden sm:inline">
        <kbd class="font-mono">↑ ↓</kbd> navigate
        <span class="mx-2">·</span>
        <kbd class="font-mono">enter</kbd> open
      </span>
    </div>
  </div>
</div>

<script>
  type PagefindResult = {
    id: string;
    data: () => Promise<{
      url: string;
      excerpt: string;
      meta: { title?: string };
      filters: Record<string, string[]>;
    }>;
  };

  type Pagefind = {
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  };

  const dialog = document.getElementById('search-dialog');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const closeBtn = document.getElementById('search-close');
  const results = document.getElementById('search-results');
  const empty = document.getElementById('search-empty');
  const noResults = document.getElementById('search-no-results');
  const unavailable = document.getElementById('search-unavailable');
  const status = document.getElementById('search-status');

  if (!dialog || !input || !results) {
    // bail — the page didn't render the dialog (shouldn't happen)
  } else {
    let pagefind: Pagefind | null = null;
    let lastQuery = '';
    let activeIndex = -1;
    let triggerEl: HTMLElement | null = null;

    async function ensurePagefind() {
      if (pagefind) return pagefind;
      try {
        // Vite would try to resolve this at build time; the dynamic import
        // string keeps it as a runtime fetch.
        const url = '/pagefind/pagefind.js';
        const module = await import(/* @vite-ignore */ url);
        await module.options?.({ excerptLength: 30 });
        pagefind = module as Pagefind;
        return pagefind;
      } catch (err) {
        console.warn('[search] pagefind not available:', err);
        return null;
      }
    }

    function openDialog() {
      if (!dialog || !input) return;
      triggerEl = (document.activeElement as HTMLElement) ?? null;
      dialog.classList.remove('hidden');
      dialog.classList.add('flex');
      dialog.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
      input.value = '';
      results!.innerHTML = '';
      activeIndex = -1;
      empty?.classList.remove('hidden');
      noResults?.classList.add('hidden');
      unavailable?.classList.add('hidden');
      window.requestAnimationFrame(() => input.focus());
      // Eager-load the index on open so the first keystroke is fast.
      void ensurePagefind().then((p) => {
        if (!p) unavailable?.classList.remove('hidden');
      });
    }

    function closeDialog() {
      if (!dialog) return;
      dialog.classList.add('hidden');
      dialog.classList.remove('flex');
      dialog.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      triggerEl?.focus();
    }

    function highlight(idx: number) {
      if (!results) return;
      const items = results.querySelectorAll<HTMLAnchorElement>('a[data-result]');
      items.forEach((el, i) => {
        const on = i === idx;
        el.classList.toggle('bg-[--color-bone]', on);
        el.setAttribute('aria-selected', on ? 'true' : 'false');
        if (on) el.scrollIntoView({ block: 'nearest' });
      });
      activeIndex = idx;
    }

    async function runSearch(q: string) {
      if (!results) return;
      lastQuery = q;
      const trimmed = q.trim();
      if (!trimmed) {
        results.innerHTML = '';
        empty?.classList.remove('hidden');
        noResults?.classList.add('hidden');
        if (status) status.textContent = '';
        activeIndex = -1;
        return;
      }
      const pf = await ensurePagefind();
      if (lastQuery !== q) return; // dropped a stale query
      if (!pf) {
        unavailable?.classList.remove('hidden');
        empty?.classList.add('hidden');
        return;
      }
      unavailable?.classList.add('hidden');
      empty?.classList.add('hidden');

      const search = await pf.search(q);
      if (lastQuery !== q) return;

      if (search.results.length === 0) {
        results.innerHTML = '';
        noResults?.classList.remove('hidden');
        if (status) status.textContent = `No results for "${q}"`;
        activeIndex = -1;
        return;
      }
      noResults?.classList.add('hidden');

      const top = search.results.slice(0, 8);
      const data = await Promise.all(top.map((r) => r.data()));
      results.innerHTML = data
        .map((d, i) => {
          const title = d.meta.title ?? d.url;
          return `
            <li role="option">
              <a
                href="${d.url}"
                data-result
                data-index="${i}"
                class="block px-5 py-4 hover:bg-[--color-bone] aria-[selected=true]:bg-[--color-bone]"
                aria-selected="false"
              >
                <p class="font-display text-base">${escapeHtml(title)}</p>
                <p class="mt-1 text-xs text-[--color-mute] truncate">${d.url}</p>
                <p class="mt-2 text-sm text-[--color-mute] line-clamp-2">${d.excerpt}</p>
              </a>
            </li>
          `;
        })
        .join('');
      if (status)
        status.textContent = `${search.results.length} result${search.results.length === 1 ? '' : 's'}`;
      activeIndex = 0;
      highlight(0);
    }

    function escapeHtml(s: string): string {
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    // Wire input
    let debounce: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(debounce);
      const q = input.value;
      debounce = window.setTimeout(() => void runSearch(q), 120);
    });

    closeBtn?.addEventListener('click', closeDialog);

    // Click backdrop to close
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });

    // Global key handler
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      const typing =
        target?.tagName === 'INPUT' || target?.tagName === 'TEXTAREA' || target?.isContentEditable;
      const open = !dialog.classList.contains('hidden');

      // Open shortcuts
      if (!open && !typing && e.key === '/') {
        e.preventDefault();
        openDialog();
        return;
      }
      if (!open && (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openDialog();
        return;
      }

      // Closed: don't handle any others
      if (!open) return;

      // Open: nav keys
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDialog();
        return;
      }
      const items = results!.querySelectorAll<HTMLAnchorElement>('a[data-result]');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (items.length === 0) return;
        highlight((activeIndex + 1) % items.length);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (items.length === 0) return;
        highlight(activeIndex <= 0 ? items.length - 1 : activeIndex - 1);
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0 && items[activeIndex]) {
          items[activeIndex].click();
        }
      }
    });

    // Open buttons elsewhere in the page (e.g. the header) wire via data attr
    document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((el) => {
      el.addEventListener('click', openDialog);
    });
  }
</script>
