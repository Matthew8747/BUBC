---
/**
 * Footer — dark navy, paper text, four content columns + thin sponsor strip above.
 *
 * Static link lists — the footer nav is intentionally hard-coded, not Sanity-driven.
 */
import Container from '../ui/Container.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import SportUniBadge from './SportUniBadge.astro';
import { safeFetch } from '../../lib/sanity';
import { allSponsorsQuery } from '../../lib/queries';
import type { SponsorData } from '../../lib/types';

interface Link {
  label: string;
  href: string;
  external?: boolean;
}

interface Column {
  heading: string;
  links: Link[];
}

const columns: Column[] = [
  {
    heading: 'Club',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'History', href: '/about/history/' },
      { label: 'Henley honours', href: '/about/henley-honours/' },
      { label: 'Olympians', href: '/about/olympians/' },
      { label: 'Chairs of BUBC', href: '/about/chairs/' },
      { label: 'Blazers', href: '/about/blazers/' },
      { label: 'Committee', href: '/committee/' },
      { label: 'Welfare & safeguarding', href: '/welfare/' },
    ],
  },
  {
    heading: 'Row',
    links: [
      { label: 'Senior men', href: '/squads/senior-men/' },
      { label: 'Senior women', href: '/squads/senior-women/' },
      { label: 'Novice', href: '/squads/novice/' },
      { label: 'Trial with us', href: '/squads/trial/' },
      { label: 'Coaching', href: '/coaching/' },
      { label: 'Boathouse fleet', href: '/boathouse/fleet/' },
      { label: 'Race results', href: '/results/' },
      { label: 'Events', href: '/events/' },
    ],
  },
  {
    heading: 'Support',
    links: [
      { label: 'Donate', href: '/support/donate/' },
      { label: 'Buy a boat', href: '/support/buy-a-boat/' },
      { label: 'Sponsor BUBC', href: '/support/sponsor/' },
      { label: 'Campaigns', href: '/support/campaigns/' },
    ],
  },
  {
    heading: 'Alumni & connect',
    links: [
      { label: 'Alumni', href: '/alumni/' },
      { label: 'Meles BC', href: '/alumni/meles/' },
      { label: 'Alumni events', href: '/alumni/events/' },
      { label: 'Instagram', href: 'https://instagram.com/crewbath_', external: true },
      { label: 'YouTube', href: 'https://youtube.com/@CrewBath', external: true },
      { label: 'Strava', href: 'https://www.strava.com/clubs/bubc', external: true },
      { label: 'Contact', href: '/contact/' },
    ],
  },
];

const year = new Date().getFullYear();

// Sponsor strip — pulled from Sanity sponsor docs (ordered by tier in the query).
// No hardcoded fallback: an empty list hides the strip rather than naming
// organisations that may not actually be sponsoring the club.
const sponsors = (await safeFetch<SponsorData[]>(allSponsorsQuery)) ?? [];
---

<footer class="bg-(--color-navy) text-(--color-paper)">
  <SportUniBadge />

  {/* Sponsor strip — sponsor docs from Sanity, ordered by tier. Hidden when empty. */}
  <div class="border-b border-(--color-paper)/10" hidden={sponsors.length === 0}>
    <Container
      class="py-6 flex flex-wrap items-center gap-x-10 gap-y-4 justify-center sm:justify-between"
    >
      <span class="text-xs uppercase tracking-[0.18em] text-(--color-paper)/60">
        With thanks to our sponsors
      </span>
      <div class="flex items-center flex-wrap gap-x-8 gap-y-3 text-sm text-(--color-paper)/70">
        {
          sponsors.map((s) =>
            s.website ? (
              <a
                href={s.website}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-(--color-paper) transition-colors"
              >
                {s.name}
              </a>
            ) : (
              <span>{s.name}</span>
            ),
          )
        }
      </div>
    </Container>
  </div>

  <Container class="py-16 sm:py-20">
    <div class="grid lg:grid-cols-[2fr_1fr] gap-12 lg:gap-16 items-start">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-12">
        {
          columns.map((col) => (
            <div>
              <h3 class="font-display text-xl mb-4">{col.heading}</h3>
              <ul class="space-y-2.5">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.external ? '_blank' : undefined}
                      rel={l.external ? 'noopener noreferrer' : undefined}
                      class="text-sm text-(--color-paper)/80 hover:text-(--color-gold) transition-colors"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <NewsletterSignup id="footer-newsletter" tone="dark" />
    </div>

    <div
      class="mt-16 pt-8 border-t border-(--color-paper)/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
    >
      <div class="text-xs text-(--color-paper)/60 leading-relaxed">
        <p>© {year} University of Bath Boat Club. All rights reserved.</p>
        <p class="mt-1">Registered charity in England & Wales (1206187).</p>
      </div>
      <div class="text-xs text-(--color-paper)/60 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/welfare/" class="hover:text-(--color-paper)">Welfare</a>
        <a href="/privacy/" class="hover:text-(--color-paper)">Privacy</a>
        <a href="/press/" class="hover:text-(--color-paper)">Press</a>
        <a href="/news/rss.xml" class="hover:text-(--color-paper)">RSS</a>
      </div>
    </div>
  </Container>
</footer>
