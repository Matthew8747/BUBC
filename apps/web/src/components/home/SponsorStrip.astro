---
/**
 * SponsorStrip — paper-tone band with sponsor logos.
 *
 * There is deliberately no hardcoded fallback list: naming a partner who has
 * not actually backed the club would be a fabrication on a live public page.
 * With no sponsors passed in, the band renders nothing at all.
 *
 * Laid out as a centred wrap rather than a fixed grid so any number of
 * sponsors sits evenly. A 5-column grid left a lone logo stranded in the last
 * column whenever the count wasn't a multiple of five.
 *
 * The greyscale filter and `mix-blend-multiply` both sit on the <img>. A
 * filter on the wrapping <a> would isolate the blend, so the white boxes
 * baked into some supplied logos would stay white against the paper tone.
 */
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { urlFor } from '../../lib/sanity';
import type { SponsorData } from '../../lib/types';

interface Props {
  heading?: string;
  sponsors?: SponsorData[];
}

// `??` instead of destructuring default — Sanity returns `null` for empty arrays.
const { heading = 'With thanks to our sponsors' } = Astro.props;
const sponsors = Astro.props.sponsors ?? [];

const logoClass = [
  'max-h-full w-auto max-w-[9rem] sm:max-w-[11rem] object-contain',
  'mix-blend-multiply grayscale opacity-70 transition duration-300',
  'group-hover:grayscale-0 group-hover:opacity-100',
  'group-focus-visible:grayscale-0 group-focus-visible:opacity-100',
].join(' ');
---

{
  sponsors.length > 0 && (
    <Section tone="paper" spacing="md">
      <Container>
        <div class="flex flex-col items-center text-center">
          <Eyebrow>Sponsors</Eyebrow>
          <h2 class="mt-3 text-2xl sm:text-3xl">{heading}</h2>
        </div>

        <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-10 gap-y-10 sm:gap-x-14">
          {sponsors.map((s) => {
            const content = s.logo?.asset ? (
              <img
                src={urlFor(s.logo).height(96).fit('max').auto('format').url()}
                alt={s.name}
                class={logoClass}
                loading="lazy"
              />
            ) : (
              <span class="font-display text-base text-(--color-mute) transition group-hover:text-(--color-ink)">
                {s.name}
              </span>
            );

            return (
              <li class="flex h-10 items-center justify-center sm:h-12">
                {s.website ? (
                  <a
                    href={s.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex h-full items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-gold)"
                  >
                    {content}
                  </a>
                ) : (
                  <div class="flex h-full items-center justify-center">{content}</div>
                )}
              </li>
            );
          })}
        </ul>
      </Container>
    </Section>
  )
}
