---
/**
 * SponsorStrip — paper-tone band with sponsor logos.
 *
 * There is deliberately no hardcoded fallback list: naming a partner who has
 * not actually backed the club would be a fabrication on a live public page.
 * With no sponsors passed in, the band renders nothing at all.
 */
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { urlFor } from '../../lib/sanity';
import type { SponsorData } from '../../lib/types';

interface Props {
  heading?: string;
  sponsors?: SponsorData[];
}

// `??` instead of destructuring default — Sanity returns `null` for empty arrays.
const { heading = 'With thanks to our sponsors' } = Astro.props;
const sponsors = Astro.props.sponsors ?? [];
---

{
  sponsors.length > 0 && (
    <Section tone="paper" spacing="md">
      <Container>
        <div class="flex flex-col items-center text-center">
          <Eyebrow>Sponsors</Eyebrow>
          <h2 class="mt-3 text-2xl sm:text-3xl">{heading}</h2>
        </div>

        <div class="mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-8 gap-y-10 items-center">
          {sponsors.map((s) => {
            const content = (
              <>
                {s.logo?.asset ? (
                  <img
                    src={urlFor(s.logo).height(80).fit('max').auto('format').url()}
                    alt={s.name}
                    width={160}
                    height={48}
                    class="h-12 w-auto object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="font-display text-base text-(--color-mute)">{s.name}</span>
                )}
              </>
            );

            if (s.website) {
              return (
                <a
                  href={s.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all"
                  aria-label={s.name}
                >
                  {content}
                </a>
              );
            }

            return (
              <div class="flex items-center justify-center grayscale opacity-70">{content}</div>
            );
          })}
        </div>
      </Container>
    </Section>
  )
}
