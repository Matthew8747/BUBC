---
/**
 * InstagramCta — bold "follow us on Instagram" band for the home page.
 *
 * Deliberately a follow call-to-action, not a live embedded feed: Instagram
 * has no clean public endpoint to read at build time (unlike the Hubbub totals),
 * and a third-party feed widget would drop tracking cookies — which would force
 * a PECR consent banner the rest of the site is built to avoid. So this points
 * people at the real account, where the day-to-day stories and updates live.
 *
 * Handle/URL default to the club account but can be overridden (e.g. wired to
 * Sanity settings later).
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';

interface Props {
  handle?: string;
  url?: string;
  heading?: string;
  blurb?: string;
}

const {
  handle = 'crewbath_',
  url = 'https://www.instagram.com/crewbath_/',
  heading = 'Follow the squad on Instagram.',
  blurb = "The day-to-day of the club lives on Instagram — training, race days, and the moments between. If you're an alum, it's the quickest way to stay close to the current crews.",
} = Astro.props;
---

<Section tone="bone" spacing="md">
  <Container>
    <div
      class="flex flex-col items-center text-center gap-6 sm:flex-row sm:items-center sm:text-left sm:justify-between sm:gap-10"
    >
      <div class="max-w-xl">
        <Eyebrow>Instagram</Eyebrow>
        <h2 class="mt-3 font-display text-3xl sm:text-4xl">{heading}</h2>
        <p class="mt-4 leading-relaxed text-(--color-mute)">{blurb}</p>
      </div>

      <div class="flex flex-col items-center gap-4 flex-shrink-0">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 group"
          aria-label={`Follow @${handle} on Instagram`}
        >
          <span
            class="grid place-items-center h-14 w-14 rounded-2xl bg-(--color-navy)/5 border border-(--color-navy)/15 transition-colors group-hover:bg-(--color-navy)/10"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-7 w-7 text-(--color-navy)"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </span>
          <span class="font-display text-xl group-hover:text-(--color-gold-text) transition-colors"
            >@{handle}</span
          >
        </a>
        <Button href={url} variant="gold" size="lg" external>Follow us</Button>
      </div>
    </div>
  </Container>
</Section>
