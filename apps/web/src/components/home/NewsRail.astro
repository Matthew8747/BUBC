---
/**
 * NewsRail — 3 latest news cards.
 *
 * With no posts in Sanity the rail renders an honest empty state rather than
 * invented headlines: this is a live, public site, so nothing here may be a
 * stand-in for real content.
 */
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Tag from '../ui/Tag.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Picture from '../content/Picture.astro';
import type { NewsCardData } from '../../lib/types';

interface Props {
  posts?: NewsCardData[];
}

// `??` instead of destructuring default — Sanity returns `null` for empty arrays.
const items = Astro.props.posts ?? [];

function fmt(date: string) {
  return new Date(date).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}
---

<Section spacing="lg">
  <Container>
    <div class="flex items-end justify-between gap-6 mb-12">
      <div>
        <Eyebrow>Latest</Eyebrow>
        <h2 class="mt-3 text-3xl sm:text-4xl">News from the boathouse</h2>
      </div>
      <a
        href="/news/"
        class="hidden sm:inline-flex items-center gap-2 text-sm font-medium text-(--color-navy) hover:text-(--color-gold-text) transition-colors"
      >
        All news
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path
            d="M3 7h8M7 3l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    {
      items.length === 0 && (
        <div class="rounded border border-dashed border-(--color-line) bg-(--color-bone)/60 p-10 text-center max-w-2xl mx-auto">
          <h3 class="font-display text-2xl">No reports posted yet this season</h3>
          <p class="mt-3 text-sm text-(--color-mute)">
            Race reports and squad news land here as the season runs. Follow{' '}
            <a
              class="underline"
              href="https://www.instagram.com/crewbath_/"
              rel="noopener noreferrer"
              target="_blank"
            >
              @crewbath_
            </a>{' '}
            in the meantime, or send us something for the site —{' '}
            <a class="underline" href="mailto:press@bubc.co.uk">
              press@bubc.co.uk
            </a>
            .
          </p>
        </div>
      )
    }

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        items.slice(0, 3).map((post) => (
          <article class="group relative flex flex-col">
            <a
              href={`/news/${post.slug}/`}
              class="absolute inset-0 z-10"
              aria-label={`Read: ${post.title}`}
            >
              <span class="sr-only">Read</span>
            </a>
            <Picture
              image={post.heroImage}
              ratio="4/5"
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              fallbackLabel={post.title}
              class="transition-transform duration-500 group-hover:scale-[1.02]"
            />
            <div class="mt-5">
              {post.category && <Tag tone="gold">{post.category.title}</Tag>}
              <h3 class="mt-3 text-xl sm:text-2xl group-hover:underline decoration-(--color-gold) underline-offset-4">
                {post.title}
              </h3>
              <p class="mt-2 text-sm text-(--color-mute)">{fmt(post.publishDate)}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 sm:hidden">
      <a
        href="/news/"
        class="inline-flex items-center gap-2 text-sm font-medium text-(--color-navy)"
      >
        All news →
      </a>
    </div>
  </Container>
</Section>
