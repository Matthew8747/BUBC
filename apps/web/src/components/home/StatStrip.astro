---
/**
 * StatStrip — dark band of 4 big-number stats. Driven by Sanity if present,
 * sensible defaults otherwise.
 */
import Stat from '../ui/Stat.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import type { Stat as StatType } from '../../lib/types';

interface Props {
  stats?: StatType[];
}

const defaults: StatType[] = [
  { value: '1966', label: 'Founded' },
  { value: '140', suffix: '+', label: 'Athletes' },
  { value: '9', label: 'BUBC Olympians' },
  { value: '60', suffix: 'yrs', label: 'Years on the Avon' },
];

// `??` instead of destructuring default — Sanity returns `null` for empty arrays.
const stats = Astro.props.stats ?? defaults;
---

<Section tone="ink" spacing="md">
  <Container>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-10 text-(--color-paper)">
      {
        stats.map((s) => (
          <div class="text-(--color-paper)">
            <Stat value={s.value} suffix={s.suffix} label={s.label} />
          </div>
        ))
      }
    </div>
  </Container>
</Section>
