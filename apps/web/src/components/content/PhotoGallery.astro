---
/**
 * PhotoGallery — responsive grid of Sanity images with a click-to-zoom lightbox.
 *
 * The grid is a regular 4:5 card layout (the editorial language wants
 * regularity). Clicking any photo opens an accessible full-screen viewer:
 *   - native <dialog> (Esc + focus trap for free)
 *   - prev / next + arrow keys, click backdrop to close
 *   - caption + credit shown beneath the image
 *
 * Degrades gracefully: each thumbnail is a real <a> to the full-size image, so
 * with JS disabled the photo still opens. JS intercepts the click for the
 * in-page viewer. Multiple galleries per page are supported — the bundled
 * script wires up every [data-gallery] on load.
 */
import Picture from './Picture.astro';
import { urlFor } from '../../lib/sanity';
import type { SanityImage } from '../../lib/types';

interface Props {
  images?: SanityImage[];
  emptyLabel?: string;
}

const { images = [], emptyLabel = 'Photos to come' } = Astro.props;

const hasAsset = (img: SanityImage) => Boolean(img?.asset?._id || img?.asset?._ref);

// Only photos with a resolvable asset can open in the viewer; build the grid
// and the lightbox data from the same filtered list so indices stay aligned.
const items = images.filter(hasAsset).map((img) => ({
  image: img,
  full: urlFor(img).width(1800).fit('max').auto('format').quality(85).url(),
  alt: img.decorative ? '' : (img.alt ?? ''),
  caption: img.caption ?? '',
  credit: img.credit ?? '',
}));

// JSON for the viewer. Escape `<` so a caption can never break out of the tag.
const lightboxData = JSON.stringify(
  items.map(({ full, alt, caption, credit }) => ({ full, alt, caption, credit })),
).replace(/</g, '\\u003c');
---

{
  items.length === 0 ? (
    <p class="italic text-(--color-mute)">{emptyLabel}</p>
  ) : (
    <div class="not-prose" data-gallery>
      <ul class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {items.map((item, i) => (
          <li>
            <a
              href={item.full}
              class="gallery-item group relative block cursor-zoom-in"
              data-index={i}
              aria-label={`View photo${item.caption ? `: ${item.caption}` : ` ${i + 1} of ${items.length}`}`}
            >
              <Picture
                image={item.image}
                ratio="4/5"
                sizes="(min-width: 1024px) 33vw, 50vw"
                priority={i === 0}
                class="transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </a>
          </li>
        ))}
      </ul>

      <script type="application/json" class="gallery-data" is:inline set:html={lightboxData} />

      <dialog class="lb" aria-label="Photo viewer" data-lightbox>
        <button type="button" class="lb-close" data-close aria-label="Close viewer">
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
        <button type="button" class="lb-nav lb-prev" data-prev aria-label="Previous photo">
          <svg
            viewBox="0 0 24 24"
            width="26"
            height="26"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 5l-7 7 7 7" />
          </svg>
        </button>
        <figure class="lb-figure">
          <img class="lb-img" data-img alt="" />
          <figcaption class="lb-cap" data-cap />
        </figure>
        <button type="button" class="lb-nav lb-next" data-next aria-label="Next photo">
          <svg
            viewBox="0 0 24 24"
            width="26"
            height="26"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
        <p class="lb-count" data-count aria-live="polite" />
      </dialog>
    </div>
  )
}

<style>
  .lb[open] {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: transparent;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.25rem, 2vw, 1.5rem);
    color: var(--color-paper);
  }

  .lb::backdrop {
    background: rgb(8 13 24 / 0.93);
  }

  .lb-figure {
    grid-column: 2;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    max-height: 100%;
  }

  .lb-img {
    max-width: 100%;
    max-height: 78dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.5);
    background: rgb(255 255 255 / 0.04);
  }

  .lb-cap {
    margin-top: 0.9rem;
    max-width: 60ch;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(244 241 234 / 0.85);
  }

  .lb-cap:empty {
    display: none;
  }

  .lb-nav,
  .lb-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-paper);
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lb-nav:hover,
  .lb-close:hover {
    background: rgb(255 255 255 / 0.22);
  }

  .lb-nav:focus-visible,
  .lb-close:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }

  .lb-nav {
    width: clamp(2.5rem, 6vw, 3.25rem);
    height: clamp(2.5rem, 6vw, 3.25rem);
  }

  .lb-prev {
    grid-column: 1;
  }

  .lb-next {
    grid-column: 3;
  }

  .lb-nav[hidden] {
    display: none;
  }

  .lb-close {
    position: absolute;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    width: 2.75rem;
    height: 2.75rem;
    z-index: 1;
  }

  .lb-count {
    position: absolute;
    bottom: clamp(0.75rem, 2vw, 1.25rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgb(244 241 234 / 0.6);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lb[open] {
      animation: lb-fade 0.2s ease;
    }
    .lb[open] .lb-img {
      animation: lb-rise 0.25s ease;
    }
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes lb-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>

<script>
  function initGallery(root: HTMLElement) {
    const dataEl = root.querySelector('.gallery-data');
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!dataEl || !dialog) return;

    type Item = { full: string; alt: string; caption: string; credit: string };
    let items: Item[] = [];
    try {
      items = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }
    if (items.length === 0) return;

    const img = dialog.querySelector<HTMLImageElement>('[data-img]')!;
    const cap = dialog.querySelector<HTMLElement>('[data-cap]')!;
    const count = dialog.querySelector<HTMLElement>('[data-count]')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-next]')!;
    const single = items.length <= 1;
    prevBtn.hidden = single;
    nextBtn.hidden = single;

    let idx = 0;

    const render = () => {
      const item = items[idx];
      img.src = item.full;
      img.alt = item.alt;
      const text = [item.caption, item.credit].filter(Boolean).join(' — ');
      cap.textContent = text;
      count.textContent = single ? '' : `${idx + 1} / ${items.length}`;
    };

    const open = (i: number) => {
      idx = i;
      render();
      if (!dialog.open) dialog.showModal();
    };
    const close = () => dialog.open && dialog.close();
    const step = (delta: number) => {
      idx = (idx + delta + items.length) % items.length;
      render();
    };

    root.querySelectorAll<HTMLAnchorElement>('[data-index]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        open(Number(a.dataset.index));
      });
    });

    dialog.querySelector('[data-close]')!.addEventListener('click', close);
    nextBtn.addEventListener('click', () => step(1));
    prevBtn.addEventListener('click', () => step(-1));

    // Click on the backdrop area (the dialog itself, not its children) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (single) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        step(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        step(-1);
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>
