---
/**
 * NewsCard — single news post card used in the index grid + category pages.
 *
 * Composes a Picture (with placeholder fallback), category Tag, headline,
 * date, and excerpt. The whole card is one clickable region via a stretched
 * link overlay, but the headline is the accessible name.
 */
import Picture from '../content/Picture.astro';
import Tag from '../ui/Tag.astro';
import type { NewsCardData } from '../../lib/types';

interface Props {
  post: NewsCardData;
  /** Eager-load the first card in a grid to help LCP. */
  priority?: boolean;
  /** Compact variant: smaller image, single-column friendly. */
  compact?: boolean;
}

const { post, priority = false, compact = false } = Astro.props;

const href = post.slug.startsWith('placeholder-') ? '#' : `/news/${post.slug}/`;

const datetime = post.publishDate ? new Date(post.publishDate) : undefined;
const dateLabel = datetime
  ? datetime.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : null;
const dateIso = datetime ? datetime.toISOString() : undefined;
---

<article class:list={['group relative flex flex-col', compact && 'sm:flex-row sm:gap-6']}>
  <a
    href={href}
    class="absolute inset-0 z-10"
    aria-label={`Read article: ${post.title}`}
    data-pagefind-meta={`title:${post.title}`}
  >
    <span class="sr-only">Read</span>
  </a>
  <Picture
    image={post.heroImage}
    ratio={compact ? '3/2' : '4/5'}
    sizes={compact
      ? '(min-width: 640px) 33vw, 100vw'
      : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
    priority={priority}
    fallbackLabel={post.title}
    class={`transition-transform duration-500 group-hover:scale-[1.02] ${compact ? 'sm:w-1/3 sm:flex-shrink-0' : ''}`}
  />
  <div class={`mt-5 ${compact ? 'sm:mt-0 sm:flex-1' : ''}`}>
    {post.category && <Tag tone="gold">{post.category.title}</Tag>}
    <h3
      class="mt-3 text-xl sm:text-2xl group-hover:underline decoration-(--color-gold) underline-offset-4 text-balance"
    >
      {post.title}
    </h3>
    {
      dateLabel && (
        <p class="mt-2 text-sm text-(--color-mute)">
          <time datetime={dateIso}>{dateLabel}</time>
          {post.author && <span class="ml-2 opacity-80">· {post.author}</span>}
        </p>
      )
    }
    {post.excerpt && <p class="mt-3 text-sm text-(--color-mute) line-clamp-3">{post.excerpt}</p>}
  </div>
</article>
