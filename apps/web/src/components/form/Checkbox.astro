---
interface Props {
  name: string;
  label: string;
  hint?: string;
  required?: boolean;
  value?: string;
}

const { name, label, hint, required, value = 'yes' } = Astro.props;
const id = `f-${name}`;
const hintId = hint ? `${id}-hint` : undefined;
---

<div class="flex items-start gap-3">
  <input
    id={id}
    name={name}
    type="checkbox"
    value={value}
    required={required}
    aria-describedby={hintId}
    class="mt-1 accent-[--color-navy] h-4 w-4"
  />
  <label for={id} class="text-sm text-[--color-ink]">
    {label}{
      required && (
        <span aria-hidden="true" class="text-[--color-blade] ml-0.5">
          *
        </span>
      )
    }
    {
      hint && (
        <span id={hintId} class="block text-xs text-[--color-mute] mt-0.5">
          {hint}
        </span>
      )
    }
  </label>
</div>
