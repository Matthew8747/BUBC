---
interface Option {
  value: string;
  label: string;
  description?: string;
}

interface Props {
  name: string;
  legend: string;
  options: Option[];
  required?: boolean;
  hint?: string;
}

const { name, legend, options, required, hint } = Astro.props;
const hintId = hint ? `${name}-hint` : undefined;
---

<fieldset class="flex flex-col gap-3" aria-describedby={hintId}>
  <legend class="text-sm font-medium text-(--color-ink)">
    {legend}{
      required && (
        <span aria-hidden="true" class="text-(--color-blade) ml-0.5">
          *
        </span>
      )
    }
  </legend>
  {
    hint && (
      <p id={hintId} class="text-xs text-(--color-mute)">
        {hint}
      </p>
    )
  }
  <div class="grid sm:grid-cols-2 gap-2">
    {
      options.map((opt, idx) => (
        <label class="flex items-start gap-3 p-3.5 border border-(--color-line) rounded-sm cursor-pointer hover:border-(--color-navy) has-[:checked]:border-(--color-navy) has-[:checked]:bg-(--color-bone) transition-colors">
          <input
            type="radio"
            name={name}
            value={opt.value}
            required={required && idx === 0}
            class="mt-0.5 accent-(--color-navy)"
          />
          <span>
            <span class="block text-sm font-medium text-(--color-ink)">{opt.label}</span>
            {opt.description && (
              <span class="block text-xs text-(--color-mute) mt-0.5">{opt.description}</span>
            )}
          </span>
        </label>
      ))
    }
  </div>
</fieldset>
