---
/**
 * TrainingScheduleTable — weekly outline as a sortable, accessible table.
 *
 * Rows are sorted by day-of-week ordering then start time. If the schedule is
 * empty we render a "to be confirmed" notice rather than an empty table.
 */
import type { TrainingSession } from '../../lib/types';

interface Props {
  sessions?: TrainingSession[];
}

const { sessions = [] } = Astro.props;

const dayOrder = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

const sorted = [...sessions].sort((a, b) => {
  const da = dayOrder.indexOf(a.day ?? '');
  const db = dayOrder.indexOf(b.day ?? '');
  if (da !== db) return da - db;
  return (a.startTime ?? '').localeCompare(b.startTime ?? '');
});
---

{
  sorted.length === 0 ? (
    <p class="italic text-[--color-mute]">
      Training schedule for the upcoming season is being finalised. Sign up for a trial and the
      captain will share it directly.
    </p>
  ) : (
    <div class="overflow-x-auto -mx-4 sm:mx-0">
      <table class="w-full text-left text-sm tabular-nums">
        <thead class="border-b border-[--color-ink]/20 text-xs uppercase tracking-[0.12em] text-[--color-mute]">
          <tr>
            <th scope="col" class="py-3 pl-4 sm:pl-0 pr-4 font-medium">
              Day
            </th>
            <th scope="col" class="py-3 px-4 font-medium">
              Time
            </th>
            <th scope="col" class="py-3 px-4 font-medium">
              Session
            </th>
            <th scope="col" class="py-3 px-4 font-medium">
              Location
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[--color-ink]/10">
          {sorted.map((s) => (
            <tr>
              <td class="py-3 pl-4 sm:pl-0 pr-4 font-medium">{s.day ?? '—'}</td>
              <td class="py-3 px-4">
                {s.startTime ?? '—'}
                {s.endTime ? ` – ${s.endTime}` : ''}
              </td>
              <td class="py-3 px-4">{s.type ?? '—'}</td>
              <td class="py-3 px-4 text-[--color-mute]">{s.location ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
