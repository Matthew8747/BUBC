---
/**
 * Stat — a single big-number stat with a label underneath.
 *
 * Display font (Fraunces) for the value, tabular numerals, gold horizontal
 * divider above for the stat strip pattern.
 */
import clsx from 'clsx';

interface Props {
  value: string | number;
  label: string;
  suffix?: string;
  divider?: boolean;
  class?: string;
}

const { value, label, suffix, divider = true, class: className } = Astro.props;
---

<div class={clsx('flex flex-col gap-2', className)}>
  {divider && <div class="h-px w-12 bg-[--color-gold]" aria-hidden="true" />}
  <div class="flex items-baseline gap-1.5">
    <span class="font-display tabular text-4xl sm:text-5xl text-[--color-ink]">{value}</span>
    {suffix && <span class="font-body text-base text-[--color-mute]">{suffix}</span>}
  </div>
  <span class="text-sm uppercase tracking-[0.1em] text-[--color-mute]">{label}</span>
</div>
