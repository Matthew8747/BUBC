---
/**
 * Stat — a single big-number stat with a label underneath.
 *
 * Display font (Fraunces) for the value, tabular numerals, gold horizontal
 * divider above for the stat strip pattern.
 */
import clsx from 'clsx';

interface Props {
  value: string | number;
  label: string;
  suffix?: string;
  divider?: boolean;
  /**
   * Which surface the stat sits on. The label and suffix are muted, and a mute
   * that reads on paper (#5a6878) drops to 3.05:1 on ink — so the dark bands
   * need the inverted mute instead. Stat strips are dark, hence the default.
   */
  surface?: 'dark' | 'light';
  class?: string;
}

const { value, label, suffix, divider = true, surface = 'dark', class: className } = Astro.props;

const muteClass = surface === 'dark' ? 'text-(--color-mute-invert)' : 'text-(--color-mute)';

// If a unit was baked into the value (e.g. "60yrs", "200+") and no explicit
// suffix prop was passed, peel the trailing non-numeric part off so it renders
// in the smaller suffix style instead of crowding the big number on narrow
// screens. A plain number ("1966", "34") is left untouched.
let displayValue: string | number = value;
let displaySuffix = suffix;
if (!displaySuffix && typeof value === 'string') {
  const m = value.match(/^(\d[\d,.]*)\s*(\D.*)$/);
  if (m) {
    displayValue = m[1];
    displaySuffix = m[2];
  }
}
---

<div class={clsx('flex flex-col gap-2', className)}>
  {divider && <div class="h-px w-12 bg-(--color-gold)" aria-hidden="true" />}
  <div class="flex items-baseline gap-1">
    <span class="font-display tabular text-4xl sm:text-5xl">{displayValue}</span>
    {
      displaySuffix && (
        <span class={clsx('font-body text-xs sm:text-sm', muteClass)}>{displaySuffix}</span>
      )
    }
  </div>
  <span class={clsx('text-sm uppercase tracking-[0.1em]', muteClass)}>{label}</span>
</div>
