---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/home/Hero.astro';
import StatStrip from '../components/home/StatStrip.astro';
import NewsRail from '../components/home/NewsRail.astro';
import SquadPathway from '../components/home/SquadPathway.astro';
import SponsorStrip from '../components/home/SponsorStrip.astro';
import InstagramCta from '../components/home/InstagramCta.astro';
import ClosingCtas from '../components/home/ClosingCtas.astro';
import { safeFetch } from '../lib/sanity';
import { homePageQuery } from '../lib/queries';
import { ogImage } from '../lib/og/url';
import type { HomePage } from '../lib/types';

// Pulls the homePage singleton if it exists in Sanity. When the dataset is
// empty (early development), `data` is null and each section falls back to its
// sensible defaults so the page still looks finished.
const data = (await safeFetch<HomePage>(homePageQuery)) ?? null;

const seo = {
  title: data?.seo?.title,
  description:
    data?.seo?.description ??
    'University of Bath Boat Club — performance student rowing from the River Avon since 1966.',
  noIndex: data?.seo?.noIndex,
  image: ogImage({ kind: 'page', slug: 'home' }),
};
---

<PageLayout seo={seo}>
  <Hero
    headline={data?.heroHeadline}
    subhead={data?.heroSubhead}
    image={data?.heroImage}
    ctas={data?.heroCtas}
  />
  <StatStrip stats={data?.stats} />
  <NewsRail posts={data?.featuredNews} />
  <SquadPathway intro={data?.pathwayIntro} squads={data?.pathwaySquads} />
  <SponsorStrip heading={data?.sponsorStripHeading} sponsors={data?.sponsorStrip ?? []} />
  <InstagramCta />
  <ClosingCtas ctas={data?.closingCtas} />
</PageLayout>
