---
/**
 * Olympian detail — /about/olympians/<slug>/
 *
 * Long-form profile page: photo, BUBC years, Olympic appearances table,
 * PortableText story, current role. JSON-LD Person + breadcrumb.
 */
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Section from '../../../components/ui/Section.astro';
import Picture from '../../../components/content/Picture.astro';
import Tag from '../../../components/ui/Tag.astro';
import PortableText from '../../../components/content/PortableText.astro';
import ShareButtons from '../../../components/news/ShareButtons.astro';
import JsonLd from '../../../components/seo/JsonLd.astro';
import { safeFetch, urlFor } from '../../../lib/sanity';
import { olympianBySlugQuery, allOlympianSlugsQuery } from '../../../lib/queries';
import { SITE } from '../../../lib/seo';
import { ogImage as generateOgImage } from '../../../lib/og/url';
import type { OlympianDetail } from '../../../lib/types';

export async function getStaticPaths() {
  const slugs = (await safeFetch<{ slug: string }[]>(allOlympianSlugsQuery)) ?? [];
  return slugs.filter((s) => s.slug).map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const o = await safeFetch<OlympianDetail>(olympianBySlugQuery, { slug });

if (!o) {
  return Astro.redirect('/404');
}

const canonicalUrl = `${SITE.url}/about/olympians/${slug}/`;
const ogImage = o.photo?.asset
  ? urlFor(o.photo).width(1200).height(630).fit('crop').auto('format').url()
  : generateOgImage({ kind: 'olympian', slug: slug! });

const medals = (o.olympicYears ?? [])
  .map((y) => y.medal)
  .filter(
    (m): m is 'gold' | 'silver' | 'bronze' => m === 'gold' || m === 'silver' || m === 'bronze',
  );

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: o.name,
  url: canonicalUrl,
  alumniOf: { '@type': 'SportsOrganization', name: SITE.name, url: SITE.url },
  ...(ogImage ? { image: ogImage } : {}),
  ...(o.olympicYears && o.olympicYears.length > 0
    ? {
        award: o.olympicYears
          .filter((y) => y.medal && y.medal !== 'none')
          .map((y) => `Olympic ${y.medal} (${y.year}, ${y.event ?? ''})`.trim()),
      }
    : {}),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Olympians',
      item: `${SITE.url}/about/olympians/`,
    },
    { '@type': 'ListItem', position: 4, name: o.name, item: canonicalUrl },
  ],
};
---

<PageLayout
  seo={{
    title: o.seo?.title ?? `${o.name} — Olympian`,
    description: o.seo?.description ?? `BUBC alumni profile: ${o.name}.`,
    image: ogImage,
    canonical: canonicalUrl,
    noIndex: o.seo?.noIndex,
  }}
>
  <JsonLd data={personSchema} slot="head" />
  <JsonLd data={breadcrumbs} slot="head" />

  <Section spacing="lg">
    <Container>
      <p class="text-sm text-(--color-mute) mb-8">
        <a href="/about/" class="hover:text-(--color-navy)">About</a>
        <span class="mx-2 opacity-50">/</span>
        <a href="/about/olympians/" class="hover:text-(--color-navy)">Olympians</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-(--color-ink)">{o.name}</span>
      </p>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-5">
          <Picture
            image={o.photo}
            ratio="4/5"
            sizes="(min-width: 1024px) 40vw, 100vw"
            priority
            fallbackLabel={o.name}
          />
        </div>

        <div class="lg:col-span-7">
          <p class="text-xs uppercase tracking-[0.16em] text-(--color-mute)">BUBC alumnus</p>
          <h1 class="mt-3 font-display text-4xl sm:text-5xl md:text-6xl leading-[1.05]">
            {o.name}
          </h1>
          {o.bubcYears && <p class="mt-4 text-lg text-(--color-mute)">BUBC {o.bubcYears}</p>}
          {o.currentRole && <p class="mt-2 text-sm text-(--color-mute) italic">{o.currentRole}</p>}

          {
            o.olympicYears && o.olympicYears.length > 0 && (
              <section class="mt-10">
                <h2 class="font-display text-2xl mb-4">Olympic appearances</h2>
                <ul class="divide-y divide-(--color-line) border-t border-b border-(--color-line)">
                  {o.olympicYears
                    .slice()
                    .sort((a, b) => a.year - b.year)
                    .map((y) => (
                      <li class="flex items-baseline gap-6 py-4">
                        <span class="font-display text-2xl tabular-nums min-w-[5ch]">{y.year}</span>
                        <div class="flex-1">
                          {y.host && <p class="text-sm text-(--color-mute)">{y.host}</p>}
                          {y.event && <p class="font-medium">{y.event}</p>}
                          {y.finalPlace && (
                            <p class="text-sm text-(--color-mute)">Finished {y.finalPlace}</p>
                          )}
                        </div>
                        {y.medal && y.medal !== 'none' && <Tag tone="gold">{y.medal}</Tag>}
                      </li>
                    ))}
                </ul>
                {medals.length > 0 && (
                  <p class="mt-6 text-sm text-(--color-mute)">
                    {medals.length} Olympic medal{medals.length === 1 ? '' : 's'}:{' '}
                    {medals.join(', ')}.
                  </p>
                )}
              </section>
            )
          }

          {
            o.story && (
              <section class="mt-12">
                <h2 class="font-display text-2xl mb-4">The story</h2>
                <PortableText value={o.story} />
              </section>
            )
          }

          <div class="mt-12">
            <ShareButtons title={`${o.name} — BUBC Olympian`} url={canonicalUrl} />
          </div>
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
