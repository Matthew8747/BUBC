---
/**
 * History page — narrative + dated timeline.
 *
 * The story sits in a `page` doc in Sanity at slug `history` so editors can
 * update it without a deploy. If the doc isn't there yet, we render a brief
 * placeholder narrative + a stub timeline so the page is meaningful from
 * day one.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import PortableText from '../../components/content/PortableText.astro';
import Timeline from '../../components/content/Timeline.astro';
import { safeFetch } from '../../lib/sanity';
import { pageBySlugQuery } from '../../lib/queries';
import type { PageDoc } from '../../lib/types';

const page = (await safeFetch<PageDoc>(pageBySlugQuery, { slug: 'history' })) ?? null;

// Editorial milestones — used as a fallback timeline before the comms officer
// fills in the Sanity history doc. Update these here when meaningful events
// happen, then port to Sanity.
const fallbackTimeline = [
  {
    year: 1966,
    title: 'Club founded',
    body: 'The University of Bath Boat Club is constituted, rowing initially on the Avon at Bath.',
  },
  {
    year: 1988,
    title: 'Joins Minerva at Bathampton',
    body: 'BUBC begins sharing a boathouse with Minerva Bath Rowing Club at Bathampton — the first settled home on the Avon.',
  },
  {
    year: 2003,
    title: 'GB Start programme comes to Bath',
    body: "Bath becomes a host for the GB Rowing Team's Start programme (today the Performance Development Academy) — the Olympic talent pathway behind athletes such as Helen Glover and Heather Stanning.",
  },
  {
    year: 2005,
    title: 'Move to Newbridge',
    body: "BUBC and Minerva relocate to the Newbridge boathouse on the River Avon — the club's home to this day.",
  },
  {
    year: 2024,
    title: 'Henley Double Sculls Challenge Cup',
    body: "Jamie Gare and Cedol Dafydd win the Double Sculls Challenge Cup at Henley Royal Regatta. The same summer, BUBC's Becky Wilde takes Olympic bronze in the double sculls at Paris 2024.",
  },
  {
    year: 2025,
    title: 'Victor Ludorum at the Club Championships',
    body: 'Bath win the Victor Ludorum at the British Rowing Club Championships for the first time.',
  },
];

const seo = {
  title: page?.seo?.title ?? 'History of BUBC',
  description:
    page?.seo?.description ??
    'A short history of the University of Bath Boat Club — from a single eight in 1966 to a national-pathway rowing programme today.',
  noIndex: page?.seo?.noIndex,
};
---

<PageLayout seo={seo}>
  <PageHero
    eyebrow="History"
    headline={page?.title ?? 'Six decades on the Avon.'}
    lead={page?.intro ??
      "BUBC's story is the story of student rowing in the south-west — improvised, ambitious, and (occasionally) stubborn. From a single eight kept in a riverside shed to a programme that crews the BUCS, Henley, and Head circuits every year."}
    image={page?.heroImage}
  />

  {
    page?.body != null && (
      <Section spacing="md">
        <Container width="prose">
          <PortableText value={page.body} />
        </Container>
      </Section>
    )
  }

  <Section tone="bone" spacing="lg">
    <Container width="narrow">
      <Eyebrow>Milestones</Eyebrow>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl">A short timeline.</h2>
      <p class="mt-3 text-(--color-mute)">
        Decade by decade — major regatta finals, boathouse moves, the people who built the club.
        Send us a missing entry and the comms officer will add it.
      </p>
      <div class="mt-10">
        <Timeline entries={fallbackTimeline} />
      </div>
    </Container>
  </Section>
</PageLayout>
