---
/**
 * The Bath blazer — heritage / awards page.
 *
 * Static-mostly content. If a `page` doc with slug `blazers` exists in Sanity,
 * its body overrides the default copy; otherwise we render an editorial
 * default so the page never reads as a stub.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import PortableText from '../../components/content/PortableText.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { safeFetch } from '../../lib/sanity';
import { pageBySlugQuery } from '../../lib/queries';
import { SITE } from '../../lib/seo';
import { ogImage } from '../../lib/og/url';
import type { PageDoc } from '../../lib/types';

const page = await safeFetch<PageDoc>(pageBySlugQuery, { slug: 'blazers' });

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
    { '@type': 'ListItem', position: 3, name: 'Blazers', item: `${SITE.url}/about/blazers/` },
  ],
};

const criteria: { tier: string; rule: string; trim: string }[] = [
  {
    tier: 'Full blazer',
    rule: 'Awarded for racing in the senior squad first eight at a major regatta (BUCS A final, HRR, HWR, Eights Head A division).',
    trim: 'Gold piping on collar and cuffs · embroidered crest, full colour',
  },
  {
    tier: 'Half blazer',
    rule: 'Awarded for completing two full seasons in the senior squad or coxing a senior crew at a major regatta.',
    trim: 'Gold piping on collar only · embroidered crest, mono',
  },
  {
    tier: 'Captain’s blazer',
    rule: 'Awarded automatically on completing a year as squad captain (men, women, or novice).',
    trim: 'Double gold piping · year of office stitched in the lining',
  },
  {
    tier: 'Long service',
    rule: 'Awarded on completion of four seasons of squad rowing, regardless of crew.',
    trim: 'Single gold collar piping · BUBC bar on inside pocket',
  },
];
---

<PageLayout
  seo={{
    title: 'The Bath blazer',
    description:
      'How a Bath blazer is earned, what the trim means, and who can wear one. Awards criteria for the BUBC blazer.',
    image: ogImage({ kind: 'page', slug: 'blazers' }),
  }}
>
  <JsonLd data={breadcrumbs} slot="head" />

  <PageHero
    eyebrow="About"
    headline="The Bath blazer."
    lead="A Bath blazer is a marker — of who's raced for the senior squad, who's captained, and who's stuck with the club season after season. Earned, not bought."
  />

  <Section spacing="lg">
    <Container width="narrow">
      <p class="text-sm text-(--color-mute) mb-8">
        <a href="/about/" class="hover:text-(--color-navy)">About</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-(--color-ink)">Blazers</span>
      </p>

      {
        page?.body ? (
          <div class="prose">
            <PortableText value={page.body} />
          </div>
        ) : (
          <div class="prose">
            <p class="lead">
              The Bath blazer is navy with gold trim. There are four tiers, and only members who
              meet the criteria below can wear one. The committee reviews awards once a year, at the
              end-of-season dinner.
            </p>
            <p>
              The blazer's roots run with the club itself — gold-on-navy was carried on the first
              shells off the river in 1966, and the trim system was formalised by the committee in
              the early seventies after the first generation of half-blues started returning to row
              Henley with Meles.
            </p>
            <p>
              Blazers are made-to-measure through Perry & Co., the same tailor that supplies the
              traditional university clubs. The club doesn't take a margin on the order; you pay
              what Perry charges, with the BUBC crest and the trim level set by your award.
            </p>
          </div>
        )
      }

      <section class="mt-16 not-prose" aria-labelledby="blazer-tiers">
        <Eyebrow>Awards</Eyebrow>
        <h2 id="blazer-tiers" class="mt-3 font-display text-2xl sm:text-3xl">
          The four blazer tiers
        </h2>
        <ul class="mt-8 divide-y divide-(--color-line) border-y border-(--color-line)">
          {
            criteria.map((c) => (
              <li class="grid sm:grid-cols-[1fr_2fr] gap-x-8 gap-y-2 py-6">
                <div>
                  <p class="font-display text-xl">{c.tier}</p>
                  <p class="mt-2 text-xs uppercase tracking-[0.12em] text-(--color-gold)">
                    {c.trim}
                  </p>
                </div>
                <p class="text-sm text-(--color-ink) leading-relaxed">{c.rule}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section
        class="mt-16 not-prose border-l-2 border-(--color-gold) bg-(--color-bone) p-6 sm:p-8"
        aria-labelledby="how-to-order"
      >
        <Eyebrow>If you've been awarded</Eyebrow>
        <h2 id="how-to-order" class="mt-3 font-display text-xl">How to order yours</h2>
        <p class="mt-3 text-sm text-(--color-ink)">
          The committee notifies awardees at the end-of-season dinner. To place an order, email{' '}
          <a
            class="underline decoration-(--color-gold) underline-offset-2"
            href="mailto:treasurer@bubc.co.uk">treasurer@bubc.co.uk</a
          >
          with your award tier and contact details — they'll loop you in with Perry &amp; Co. and confirm
          the crest and trim spec.
        </p>
      </section>
    </Container>
  </Section>
</PageLayout>
