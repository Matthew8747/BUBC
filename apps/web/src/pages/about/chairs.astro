---
/**
 * Chairs of BUBC — historic list of student chairs, reverse chronological.
 *
 * Pulls `chair` documents from Sanity. Each chair gets a row with name + term
 * + optional photo + optional bio. Empty state covers the gap until the
 * archive is digitised — wording matches the Henley Honours page so editors
 * see one consistent "archive being catalogued" pattern across the site.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Picture from '../../components/content/Picture.astro';
import PortableText from '../../components/content/PortableText.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { safeFetch } from '../../lib/sanity';
import { chairsQuery } from '../../lib/queries';
import { SITE } from '../../lib/seo';
import { ogImage } from '../../lib/og/url';
import type { ChairRecord } from '../../lib/types';

const chairs = (await safeFetch<ChairRecord[]>(chairsQuery)) ?? [];

// Group by decade so the list reads as heritage rather than a flat scroll.
const byDecade = chairs.reduce<Map<number, ChairRecord[]>>((acc, c) => {
  const decade = Math.floor(c.yearFrom / 10) * 10;
  if (!acc.has(decade)) acc.set(decade, []);
  acc.get(decade)!.push(c);
  return acc;
}, new Map());
const decades = Array.from(byDecade.keys()).sort((a, b) => b - a);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
    { '@type': 'ListItem', position: 3, name: 'Chairs of BUBC', item: `${SITE.url}/about/chairs/` },
  ],
};

function term(c: ChairRecord): string {
  return `${c.yearFrom}–${c.yearTo ?? 'present'}`;
}
---

<PageLayout
  seo={{
    title: 'Chairs of BUBC',
    description:
      'Every committee chair of the University of Bath Boat Club, decade by decade — the line of student officers who have led the club since 1966.',
    image: ogImage({ kind: 'page', slug: 'chairs' }),
  }}
>
  <JsonLd data={breadcrumbs} slot="head" />

  <PageHero
    eyebrow="About"
    headline="Chairs of BUBC."
    lead="The student officers who have led the club, one year at a time, since 1966. A running record — fill any gaps you can."
  />

  <Section spacing="lg">
    <Container>
      <p class="text-sm text-(--color-mute) mb-8">
        <a href="/about/" class="hover:text-(--color-navy)">About</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-(--color-ink)">Chairs of BUBC</span>
      </p>

      {
        chairs.length > 0 ? (
          <div class="space-y-16">
            {decades.map((decade) => {
              const entries = byDecade.get(decade)!;
              return (
                <section aria-labelledby={`chairs-${decade}s`}>
                  <h2
                    id={`chairs-${decade}s`}
                    class="font-display text-3xl border-b border-(--color-line) pb-2 mb-6 tabular-nums"
                  >
                    {decade}s
                  </h2>
                  <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
                    {entries.map((c) => (
                      <li>
                        <Picture
                          image={c.photo}
                          ratio="1/1"
                          sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                          fallbackLabel="Portrait pending"
                        />
                        <div class="mt-3">
                          <Eyebrow>Chair, {term(c)}</Eyebrow>
                          <h3 class="mt-2 font-display text-xl">{c.name}</h3>
                          {c.bio && (
                            <div class="mt-3 text-sm text-(--color-mute)">
                              <PortableText value={c.bio} />
                            </div>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })}
          </div>
        ) : (
          <div class="rounded border border-dashed border-(--color-line) bg-(--color-bone)/60 p-10 text-center max-w-2xl mx-auto">
            <h2 class="font-display text-2xl">A record being assembled</h2>
            <p class="mt-3 text-sm text-(--color-mute)">
              BUBC has been chaired by a student officer every year since 1966, but the
              committee-by-committee roll-call is being rebuilt from minutes and alumni memory. If
              you chaired the club, were close to someone who did, or have a photo to credit, email{' '}
              <a class="underline" href="mailto:alumni@bubc.co.uk">
                alumni@bubc.co.uk
              </a>
              .
            </p>
          </div>
        )
      }
    </Container>
  </Section>
</PageLayout>
