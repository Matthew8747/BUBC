---
/**
 * Henley Honours — chronological record of every BUBC crew at Henley Royal
 * and Henley Women's Regatta.
 *
 * Data lives in Sanity `henleyHonour` documents. Grouped by year (newest first)
 * with regatta-tagged tables underneath each heading. The page works fine when
 * empty — that's an honest "no entries yet" state, not a fake one — because
 * the dataset will get populated over months not days.
 *
 * Filter pills above the year list let visitors narrow to HRR vs Henley Women's.
 * The filter is client-side and progressive — the underlying tables remain
 * server-rendered for SEO and no-JS fallback.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Tag from '../../components/ui/Tag.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { safeFetch } from '../../lib/sanity';
import { henleyHonoursQuery } from '../../lib/queries';
import { SITE } from '../../lib/seo';
import { ogImage } from '../../lib/og/url';
import type { HenleyHonour } from '../../lib/types';

const honours = (await safeFetch<HenleyHonour[]>(henleyHonoursQuery)) ?? [];

const regattaLabel: Record<HenleyHonour['regatta'], string> = {
  hrr: 'Henley Royal Regatta',
  hwr: "Henley Women's Regatta",
};

// Group by year, newest first.
const byYear = honours.reduce<Map<number, HenleyHonour[]>>((acc, h) => {
  if (!acc.has(h.year)) acc.set(h.year, []);
  acc.get(h.year)!.push(h);
  return acc;
}, new Map());
const years = Array.from(byYear.keys()).sort((a, b) => b - a);

const totalHRR = honours.filter((h) => h.regatta === 'hrr').length;
const totalHWR = honours.filter((h) => h.regatta === 'hwr').length;

// Light structured data so search engines recognise this as a sports record.
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Henley honours',
      item: `${SITE.url}/about/henley-honours/`,
    },
  ],
};

function seatLabel(seat?: string) {
  if (!seat) return '—';
  const lowered = seat.trim().toLowerCase();
  if (lowered === 'bow') return 'B';
  if (lowered === 'stroke') return 'S';
  if (lowered === 'cox') return 'C';
  return seat;
}

function athleteLink(name?: string, slug?: string) {
  if (slug) return { name, href: `/about/olympians/${slug}/` };
  return { name, href: null };
}
---

<PageLayout
  seo={{
    title: 'Henley honours',
    description:
      'Every BUBC crew that has competed at Henley Royal and Henley Women’s Regatta, year by year.',
    image: ogImage({ kind: 'page', slug: 'henley-honours' }),
  }}
>
  <JsonLd data={breadcrumbs} slot="head" />

  <PageHero
    eyebrow="About"
    headline="Henley honours"
    lead="A running record of every Bath crew to race on the Royal stretch — Henley Royal Regatta and Henley Women’s Regatta."
  />

  <Section spacing="lg">
    <Container>
      <p class="text-sm text-(--color-mute) mb-8">
        <a href="/about/" class="hover:text-(--color-navy)">About</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-(--color-ink)">Henley honours</span>
      </p>

      {
        honours.length > 0 ? (
          <>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-(--color-line) border border-(--color-line) mb-12">
              <div class="bg-(--color-paper) p-5">
                <div class="text-3xl font-display tabular-nums">{honours.length}</div>
                <div class="text-xs uppercase tracking-[0.12em] text-(--color-mute) mt-1">
                  Total appearances
                </div>
              </div>
              <div class="bg-(--color-paper) p-5">
                <div class="text-3xl font-display tabular-nums">{totalHRR}</div>
                <div class="text-xs uppercase tracking-[0.12em] text-(--color-mute) mt-1">
                  HRR entries
                </div>
              </div>
              <div class="bg-(--color-paper) p-5">
                <div class="text-3xl font-display tabular-nums">{totalHWR}</div>
                <div class="text-xs uppercase tracking-[0.12em] text-(--color-mute) mt-1">
                  Henley Women’s entries
                </div>
              </div>
              <div class="bg-(--color-paper) p-5">
                <div class="text-3xl font-display tabular-nums">
                  {years.length > 0 ? years[years.length - 1] : '—'}
                </div>
                <div class="text-xs uppercase tracking-[0.12em] text-(--color-mute) mt-1">
                  First appearance
                </div>
              </div>
            </div>

            <div
              class="flex flex-wrap items-center gap-2 mb-10"
              role="tablist"
              aria-label="Filter by regatta"
            >
              <button
                type="button"
                data-honour-filter
                data-filter="all"
                aria-pressed="true"
                class="honour-pill is-active inline-flex h-9 items-center rounded-full px-4 text-xs font-medium uppercase tracking-[0.12em] transition-colors"
              >
                All entries
              </button>
              <button
                type="button"
                data-honour-filter
                data-filter="hrr"
                aria-pressed="false"
                class="honour-pill inline-flex h-9 items-center rounded-full px-4 text-xs font-medium uppercase tracking-[0.12em] transition-colors"
              >
                Henley Royal ({totalHRR})
              </button>
              <button
                type="button"
                data-honour-filter
                data-filter="hwr"
                aria-pressed="false"
                class="honour-pill inline-flex h-9 items-center rounded-full px-4 text-xs font-medium uppercase tracking-[0.12em] transition-colors"
              >
                Henley Women’s ({totalHWR})
              </button>
            </div>

            <div class="space-y-16">
              {years.map((year) => {
                const entries = byYear.get(year)!;
                return (
                  <section data-year={year} aria-labelledby={`hh-year-${year}`} class="honour-year">
                    <h2
                      id={`hh-year-${year}`}
                      class="font-display text-3xl border-b border-(--color-line) pb-2 mb-6 tabular-nums"
                    >
                      {year}
                    </h2>
                    <div class="space-y-8">
                      {entries.map((h) => (
                        <article
                          data-regatta={h.regatta}
                          class="honour-entry grid md:grid-cols-[1fr_auto] gap-x-8 gap-y-3"
                        >
                          <div>
                            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                              <h3 class="font-display text-xl text-balance">{h.event}</h3>
                              <Tag tone={h.regatta === 'hrr' ? 'gold' : 'navy'}>
                                {regattaLabel[h.regatta]}
                              </Tag>
                            </div>
                            {h.crewName && (
                              <p class="text-sm text-(--color-mute) mt-1">{h.crewName}</p>
                            )}
                            {h.athletes && h.athletes.length > 0 && (
                              <ol class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                                {h.athletes.map((seat) => {
                                  const name = seat.athlete?.name ?? seat.name ?? '—';
                                  const link = athleteLink(name, seat.athlete?.slug);
                                  return (
                                    <li class="inline-flex items-baseline gap-1.5">
                                      <span class="font-mono text-xs text-(--color-mute)">
                                        {seatLabel(seat.seat)}
                                      </span>
                                      {link.href ? (
                                        <a
                                          href={link.href}
                                          class="hover:text-(--color-gold) underline decoration-transparent hover:decoration-(--color-gold) underline-offset-2"
                                        >
                                          {link.name}
                                        </a>
                                      ) : (
                                        <span>{link.name}</span>
                                      )}
                                    </li>
                                  );
                                })}
                              </ol>
                            )}
                            {(h.cox || h.coach) && (
                              <p class="text-xs text-(--color-mute) mt-3 flex flex-wrap gap-x-4">
                                {h.cox && <span>Cox: {h.cox}</span>}
                                {h.coach && <span>Coach: {h.coach}</span>}
                              </p>
                            )}
                            {h.notes && (
                              <p class="text-sm text-(--color-mute) mt-3 italic">{h.notes}</p>
                            )}
                          </div>
                          <div class="md:text-right md:min-w-[200px]">
                            <p class="text-xs uppercase tracking-[0.12em] text-(--color-mute)">
                              Furthest round
                            </p>
                            <p class="mt-1 font-display text-2xl">{h.finish}</p>
                            {h.opposition && (
                              <p class="text-xs text-(--color-mute) mt-1">vs {h.opposition}</p>
                            )}
                          </div>
                        </article>
                      ))}
                    </div>
                  </section>
                );
              })}
            </div>
          </>
        ) : (
          <div class="rounded border border-dashed border-(--color-line) bg-(--color-bone)/60 p-10 text-center max-w-2xl mx-auto">
            <h2 class="font-display text-2xl">Records are being catalogued</h2>
            <p class="mt-3 text-sm text-(--color-mute)">
              BUBC's Henley record stretches back decades. Crew lists, finishes, and opposition are
              being digitised entry by entry — when we have something to show, it'll live here. If
              you raced for Bath at Henley and want to make sure the record's right, email{' '}
              <a class="underline" href="mailto:alumni@bubc.co.uk">
                alumni@bubc.co.uk
              </a>
              .
            </p>
          </div>
        )
      }
    </Container>
  </Section>
</PageLayout>

<style>
  .honour-pill {
    border: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  .honour-pill:hover {
    border-color: var(--color-navy);
  }
  .honour-pill.is-active {
    background: var(--color-navy);
    color: var(--color-paper);
    border-color: var(--color-navy);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-honour-filter]');
  const entries = document.querySelectorAll<HTMLElement>('.honour-entry');
  const years = document.querySelectorAll<HTMLElement>('.honour-year');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';
      buttons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      entries.forEach((entry) => {
        const match = filter === 'all' || entry.dataset.regatta === filter;
        entry.style.display = match ? '' : 'none';
      });
      // Hide year sections whose entries are all filtered out.
      years.forEach((yearEl) => {
        const visible = yearEl.querySelectorAll<HTMLElement>(
          '.honour-entry:not([style*="display: none"])',
        );
        yearEl.style.display = visible.length > 0 ? '' : 'none';
      });
    });
  });
</script>
