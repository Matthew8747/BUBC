---
/**
 * Committee page — current academic year, ordered by role.
 *
 * Strategy:
 *   1. Try the current academic year (Sept → Aug rollover).
 *   2. If nothing comes back, fall back to the most recent year with data.
 *   3. If still nothing, render an honest placeholder.
 *
 * The visible academic year is shown in the eyebrow so visitors can see how
 * fresh the data is.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Picture from '../components/content/Picture.astro';
import { safeFetch } from '../lib/sanity';
import { committeeQuery, latestCommitteeYearQuery } from '../lib/queries';
import { getCurrentAcademicYear } from '../lib/academicYear';
import type { CommitteeMemberData } from '../lib/types';

const currentYear = getCurrentAcademicYear();
let displayYear = currentYear;

let members = (await safeFetch<CommitteeMemberData[]>(committeeQuery, { year: currentYear })) ?? [];

if (members.length === 0) {
  const latest = await safeFetch<string | null>(latestCommitteeYearQuery);
  if (latest && latest !== currentYear) {
    displayYear = latest;
    members = (await safeFetch<CommitteeMemberData[]>(committeeQuery, { year: latest })) ?? members;
  }
}

const seo = {
  title: `Committee — ${displayYear}`,
  description: `The University of Bath Boat Club committee for the ${displayYear} academic year.`,
};
---

<PageLayout seo={seo}>
  <PageHero
    eyebrow={`Committee · ${displayYear}`}
    headline="The people who run the club."
    lead="BUBC is a student-run club. Every role here is voluntary and elected annually — and every single person is contactable. If you're prospective, a parent, or an alum with a question, start with the role that fits."
  />

  <Section spacing="lg">
    <Container>
      {
        members.length === 0 ? (
          <div class="border-l-2 border-(--color-gold) pl-6 py-2 max-w-2xl">
            <p class="text-lg">Committee for the {displayYear} season is being elected.</p>
            <p class="mt-3 text-(--color-mute)">
              Once handover is complete the new committee will appear here with photos, roles, and
              contact emails. For anything urgent in the meantime, email{' '}
              <a
                href="mailto:info@bubc.co.uk"
                class="underline decoration-(--color-gold) underline-offset-4 hover:text-(--color-gold-text)"
              >
                info@bubc.co.uk
              </a>
              .
            </p>
          </div>
        ) : (
          <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
            {members.map((m) => (
              <li>
                <article>
                  <div class="overflow-hidden">
                    <Picture
                      image={m.photo}
                      ratio="4/5"
                      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                      fallbackLabel={m.name}
                    />
                  </div>
                  <div class="mt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-(--color-gold-text) font-medium">
                      {m.role}
                    </p>
                    <h2 class="mt-2 font-display text-xl">{m.name}</h2>
                    {m.course && <p class="mt-1 text-sm text-(--color-mute)">{m.course}</p>}
                    {m.bio && <p class="mt-3 text-sm leading-relaxed">{m.bio}</p>}
                    {m.email && (
                      <p class="mt-3 text-sm">
                        <a
                          href={`mailto:${m.email}`}
                          class="underline decoration-(--color-gold) underline-offset-4 hover:text-(--color-gold-text)"
                        >
                          {m.email}
                        </a>
                      </p>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </Container>
  </Section>
</PageLayout>
