---
/**
 * Boat detail page — /boathouse/fleet/[slug]/
 *
 * Renders a single boat's profile: photo, story (PortableText), key stats,
 * current crew (if assigned), donor callout, and a navigation strip back to
 * the fleet. Pre-renders every boat in Sanity at build time so this page is
 * fully static.
 */
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Section from '../../../components/ui/Section.astro';
import Picture from '../../../components/content/Picture.astro';
import PortableText from '../../../components/content/PortableText.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import Button from '../../../components/ui/Button.astro';
import JsonLd from '../../../components/seo/JsonLd.astro';
import { safeFetch } from '../../../lib/sanity';
import { allBoatSlugsQuery, boatBySlugQuery } from '../../../lib/queries';
import { SITE } from '../../../lib/seo';
import { ogImage } from '../../../lib/og/url';
import type { BoatDetail } from '../../../lib/types';

export const getStaticPaths = (async () => {
  const slugs = (await safeFetch<{ slug: string }[]>(allBoatSlugsQuery)) ?? [];
  return slugs.filter((s) => s.slug).map((s) => ({ params: { slug: s.slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const boat = await safeFetch<BoatDetail>(boatBySlugQuery, { slug });

if (!boat) {
  return Astro.redirect('/boathouse/fleet/');
}

const statusLabel: Record<BoatDetail['status'], string> = {
  active: 'Active in the race fleet',
  reserve: 'Reserve / training boat',
  forSale: 'For sale',
  retired: 'Retired from service',
};

const classDescription: Record<string, string> = {
  '1x': 'Single scull (one rower, two oars).',
  '2x': 'Double scull (two rowers, two oars each).',
  '2-': 'Coxless pair (two rowers, one oar each, no cox).',
  '4x': 'Quad scull (four rowers, two oars each).',
  '4x+': 'Coxed quad scull (four scullers plus a cox).',
  '4-': 'Coxless four (four rowers, one oar each, no cox).',
  '4+': 'Coxed four (four rowers plus a cox).',
  '8+': 'Eight (eight rowers plus a cox).',
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Boathouse', item: `${SITE.url}/boathouse/` },
    { '@type': 'ListItem', position: 3, name: 'Fleet', item: `${SITE.url}/boathouse/fleet/` },
    {
      '@type': 'ListItem',
      position: 4,
      name: boat.name,
      item: `${SITE.url}/boathouse/fleet/${boat.slug}/`,
    },
  ],
};

const seo = {
  title: boat.name,
  description: [boat.make, boat.class, boat.donor ? `donated by ${boat.donor}` : null]
    .filter(Boolean)
    .join(' · '),
  // Prefer real photography when uploaded; fall back to generated OG card.
  image: boat.photo?.asset?.url ?? ogImage({ kind: 'boat', slug: boat.slug }),
};
---

<PageLayout seo={seo}>
  <JsonLd data={breadcrumbs} slot="head" />

  <article>
    <Section spacing="md">
      <Container>
        <p class="text-sm text-(--color-mute) mb-6">
          <a href="/boathouse/" class="hover:text-(--color-navy)">Boathouse</a>
          <span class="mx-2 opacity-50">/</span>
          <a href="/boathouse/fleet/" class="hover:text-(--color-navy)">Fleet</a>
          <span class="mx-2 opacity-50">/</span>
          <span class="text-(--color-ink)">{boat.name}</span>
        </p>

        <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-start">
          <Picture
            image={boat.photo}
            ratio="4/5"
            sizes="(min-width: 1024px) 55vw, 100vw"
            priority
            fallbackLabel={boat.name}
          />

          <div>
            <Eyebrow>{boat.class}</Eyebrow>
            <h1 class="mt-4 font-display text-4xl sm:text-5xl leading-[1.05]">{boat.name}</h1>

            <dl
              class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-y border-(--color-ink)/10 py-6 text-sm"
            >
              <div>
                <dt class="text-xs uppercase tracking-[0.12em] text-(--color-mute)">Make</dt>
                <dd class="mt-1 font-display text-lg">{boat.make}</dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-[0.12em] text-(--color-mute)">Class</dt>
                <dd class="mt-1 font-display text-lg">{boat.class}</dd>
              </div>
              {
                boat.weight && (
                  <div>
                    <dt class="text-xs uppercase tracking-[0.12em] text-(--color-mute)">
                      Weight category
                    </dt>
                    <dd class="mt-1 font-display text-lg">
                      {boat.weight === 'heavy' ? 'Heavyweight' : 'Lightweight'}
                    </dd>
                  </div>
                )
              }
              {
                boat.yearBought && (
                  <div>
                    <dt class="text-xs uppercase tracking-[0.12em] text-(--color-mute)">
                      Acquired
                    </dt>
                    <dd class="mt-1 font-display text-lg">{boat.yearBought}</dd>
                  </div>
                )
              }
              <div class="col-span-2">
                <dt class="text-xs uppercase tracking-[0.12em] text-(--color-mute)">Status</dt>
                <dd class="mt-1 text-base">{statusLabel[boat.status]}</dd>
              </div>
            </dl>

            {
              classDescription[boat.class] && (
                <p class="mt-5 text-sm italic text-(--color-mute)">
                  {classDescription[boat.class]}
                </p>
              )
            }

            {
              boat.donor && (
                <div class="mt-8 rounded-sm border-l-4 border-(--color-gold) bg-(--color-bone)/60 p-5">
                  <p class="text-xs uppercase tracking-[0.14em] text-(--color-gold-text)">
                    Donated by
                  </p>
                  <p class="mt-2 font-display text-2xl">{boat.donor}</p>
                </div>
              )
            }

            {
              boat.namingCeremonyDate && (
                <p class="mt-5 text-sm text-(--color-mute)">
                  Christened{' '}
                  {new Date(boat.namingCeremonyDate).toLocaleDateString('en-GB', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                  .
                </p>
              )
            }
          </div>
        </div>
      </Container>
    </Section>

    {
      boat.story != null && (
        <Section tone="bone" spacing="md">
          <Container>
            <div class="max-w-3xl mx-auto">
              <Eyebrow>The story</Eyebrow>
              <h2 class="mt-3 font-display text-3xl sm:text-4xl">
                Crews, donors, and the moments that named the boat.
              </h2>
              <PortableText value={boat.story} class="mt-8" />
            </div>
          </Container>
        </Section>
      )
    }

    {
      boat.currentCrew && boat.currentCrew.length > 0 && (
        <Section spacing="md">
          <Container>
            <div class="max-w-3xl">
              <Eyebrow>Current crew</Eyebrow>
              <h2 class="mt-3 font-display text-3xl">Who's in it right now.</h2>
            </div>
            <ul class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10">
              {boat.currentCrew.map((athlete) => (
                <li class="flex flex-col">
                  <Picture
                    image={athlete.photo}
                    ratio="1/1"
                    sizes="(min-width: 1024px) 22vw, (min-width: 640px) 32vw, 50vw"
                    fallbackLabel={athlete.name}
                  />
                  <p class="mt-3 font-display text-lg">{athlete.name}</p>
                </li>
              ))}
            </ul>
          </Container>
        </Section>
      )
    }

    <Section tone="bone" spacing="sm">
      <Container class="flex flex-wrap items-center justify-between gap-6">
        <p class="text-sm text-(--color-mute)">
          Want to put a name on the fleet?{' '}
          <a
            href="/support/buy-a-boat/"
            class="underline decoration-(--color-gold) underline-offset-4"
          >
            Buy a boat
          </a>{' '}
          or{' '}
          <a href="/support/donate/" class="underline decoration-(--color-gold) underline-offset-4">
            support the next purchase
          </a>
          .
        </p>
        <Button href="/boathouse/fleet/" variant="ghost" size="sm">← Back to the fleet</Button>
      </Container>
    </Section>
  </article>
</PageLayout>
