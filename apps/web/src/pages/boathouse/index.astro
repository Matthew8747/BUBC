---
/**
 * Boathouse page — facilities, location with embedded map, fleet teaser.
 *
 * The location map is rendered as an OpenStreetMap iframe pointing at the
 * boathouse coordinates from settings. If unset we fall back to a fixed
 * Bath / Saltford reach centre — close enough to be useful, honest enough
 * that nobody walks to the wrong place.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import Picture from '../../components/content/Picture.astro';
import { safeFetch } from '../../lib/sanity';
import { settingsQuery, fleetQuery } from '../../lib/queries';
import type { Settings, BoatCardData } from '../../lib/types';

const [settings, fleet] = await Promise.all([
  safeFetch<Settings>(settingsQuery),
  safeFetch<BoatCardData[]>(fleetQuery),
]);

// Default to a sensible point on the Bath reach if coords aren't set.
const lat = settings?.boathouseLocation?.lat ?? 51.4147;
const lng = settings?.boathouseLocation?.lng ?? -2.4567;
const span = 0.006;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${lng - span},${lat - span},${lng + span},${lat + span}&layer=mapnik&marker=${lat},${lng}`;

const fleetTeaser = (fleet ?? []).slice(0, 6);

const seo = {
  title: 'Boathouse',
  description:
    "The BUBC boathouse on the River Avon — facilities, fleet, and how to find us. Bath's racing programme is built here.",
};
---

<PageLayout seo={seo}>
  <PageHero
    eyebrow="Boathouse"
    headline="On the water at Saltford."
    lead="Bath rows out of a boathouse on the River Avon, a few miles downstream of the city. From here we cover the stretch all the way to Saltford lock — long, fair, and quietly one of the best rowing reaches in the south-west."
  />

  <Section spacing="md">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <Eyebrow>Facilities</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">What's on site.</h2>
          <ul class="mt-6 space-y-4 text-[--color-ink]">
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-[--color-gold] flex-shrink-0"></span>
              <span>
                <strong class="font-display">Boat hall</strong> housing the senior eights, fours, pairs,
                sculling fleet, and reserve boats.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-[--color-gold] flex-shrink-0"></span>
              <span>
                <strong class="font-display">Indoor erg suite</strong> with Concept2 RowErgs and dynamic
                ergs for land sessions.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-[--color-gold] flex-shrink-0"></span>
              <span>
                <strong class="font-display">Weights room</strong> shared with strength &amp; conditioning
                — squat rack, platforms, dumbbells to 50&nbsp;kg.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-[--color-gold] flex-shrink-0"></span>
              <span>
                <strong class="font-display">Changing rooms &amp; kit store</strong> — secure storage
                for kit and personal effects during sessions.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-[--color-gold] flex-shrink-0"></span>
              <span>
                <strong class="font-display">Coach launches and bank-bikes</strong> for technical coaching
                the whole length of the reach.
              </span>
            </li>
          </ul>
        </div>

        <aside class="bg-[--color-bone] p-6 sm:p-8">
          <Eyebrow>Find us</Eyebrow>
          <h3 class="mt-3 font-display text-2xl">Boathouse map.</h3>
          <p class="mt-3 text-sm text-[--color-mute]">
            Park on the public road and walk down the short track to the river — there's no parking
            on the riverbank itself.
          </p>
          <div class="mt-5 border border-[--color-ink]/15">
            <iframe
              src={mapSrc}
              title="Map showing the BUBC boathouse location"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="block w-full h-72"></iframe>
          </div>
          <p class="mt-3 text-xs text-[--color-mute]">
            <a
              href={`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=16/${lat}/${lng}`}
              class="underline decoration-[--color-gold] underline-offset-4"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open on OpenStreetMap
            </a>
            ·
            <a
              href={`https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`}
              class="underline decoration-[--color-gold] underline-offset-4"
              target="_blank"
              rel="noopener noreferrer"
            >
              Directions
            </a>
            {
              settings?.boathouseLocation?.what3words && (
                <>
                  · <span>///{settings.boathouseLocation.what3words}</span>
                </>
              )
            }
          </p>
        </aside>
      </div>
    </Container>
  </Section>

  {/* Fleet teaser */}
  <Section tone="bone" spacing="md">
    <Container>
      <div class="flex items-end justify-between gap-6 flex-wrap">
        <div class="max-w-2xl">
          <Eyebrow>The fleet</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">Boats with names.</h2>
          <p class="mt-4 text-[--color-mute]">
            Every BUBC racing shell carries a name and a story — donors, christenings, crews. A
            taste of the current fleet below; the full fleet visualiser is in the works.
          </p>
        </div>
      </div>

      {
        fleetTeaser.length > 0 ? (
          <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {fleetTeaser.map((boat) => (
              <li>
                <article class="flex flex-col">
                  <Picture
                    image={boat.photo}
                    ratio="4/5"
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    fallbackLabel={boat.name}
                  />
                  <div class="mt-4">
                    <h3 class="font-display text-xl">{boat.name}</h3>
                    <p class="mt-1 text-sm text-[--color-mute]">
                      {boat.make} · {boat.class}
                      {boat.yearBought ? ` · ${boat.yearBought}` : ''}
                    </p>
                    {boat.donor && (
                      <p class="mt-2 text-xs uppercase tracking-[0.12em] text-[--color-gold]">
                        Donated by {boat.donor}
                      </p>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-8 italic text-[--color-mute]">
            Fleet profiles will be published as boat-by-boat photography is completed.
          </p>
        )
      }

      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/support/buy-a-boat/" variant="ghost">Buy a boat</Button>
        <Button href="/support/donate/" variant="solid">Support the fleet</Button>
      </div>
    </Container>
  </Section>
</PageLayout>
