---
/**
 * Boathouse page — facilities, location with embedded map, fleet teaser.
 *
 * The location map is rendered as an OpenStreetMap iframe pointing at the
 * boathouse coordinates from settings. If unset we fall back to a fixed
 * Bath / Saltford reach centre — close enough to be useful, honest enough
 * that nobody walks to the wrong place.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import Picture from '../../components/content/Picture.astro';
import PhotoGallery from '../../components/content/PhotoGallery.astro';
import ConditionsPanel from '../../components/boathouse/ConditionsPanel.astro';
import { safeFetch } from '../../lib/sanity';
import { settingsQuery, fleetQuery } from '../../lib/queries';
import type { Settings, BoatCardData } from '../../lib/types';
import JsonLd from '../../components/seo/JsonLd.astro';
import { SITE } from '../../lib/seo';

const [settings, fleet] = await Promise.all([
  safeFetch<Settings>(settingsQuery),
  safeFetch<BoatCardData[]>(fleetQuery),
]);

// Default to a sensible point on the Bath reach if coords aren't set.
const lat = settings?.boathouseLocation?.lat ?? 51.4147;
const lng = settings?.boathouseLocation?.lng ?? -2.4567;
const span = 0.006;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${lng - span},${lat - span},${lng + span},${lat + span}&layer=mapnik&marker=${lat},${lng}`;

const fleetTeaser = (fleet ?? []).slice(0, 6);

const seo = {
  title: 'Boathouse',
  description:
    "The BUBC boathouse on the River Avon — facilities, fleet, and how to find us. Bath's racing programme is built here.",
};

// SportsActivityLocation + BreadcrumbList JSON-LD — gives the boathouse a real
// place entity for "Bath rowing" / local searches, and helps Google understand
// where the club actually rows.
const boathouseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  '@id': `${SITE.url}/boathouse/#location`,
  name: 'BUBC Boathouse',
  description:
    "University of Bath Boat Club's boathouse on the River Avon, between Bath and Saltford.",
  url: `${SITE.url}/boathouse/`,
  sport: 'Rowing',
  geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lng },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Newbridge',
    addressRegion: 'Somerset',
    addressCountry: 'GB',
  },
  containedInPlace: { '@type': 'City', name: 'Bath' },
  parentOrganization: { '@id': `${SITE.url}/#organization` },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Boathouse', item: `${SITE.url}/boathouse/` },
  ],
};
---

<PageLayout seo={seo}>
  <JsonLd data={breadcrumbJsonLd} slot="head" />
  <JsonLd data={boathouseJsonLd} slot="head" />
  <PageHero
    eyebrow="Boathouse"
    headline="On the water at Newbridge."
    lead="BUBC rows out of a boathouse on the River Avon, between Bath and Saltford lock. From here the squad covers a long, fair, sheltered stretch of water — quietly one of the best university reaches in the south-west."
  />

  {/* The reach */}
  <Section spacing="md">
    <Container width="narrow">
      <Eyebrow>The reach</Eyebrow>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl">Five kilometres of fair water.</h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed">
        <p>
          The Bath-to-Saltford reach gives the squad close to five kilometres of training water;
          long enough for a head race simulation, sheltered enough to row through the winter. Shared
          with the Minerva Bath, Avon County and Bristol University.
        </p>
        <p class="text-(--color-mute)">
          Outings cover everything from technical work in fours and pairs to full eights race pace.
          The squad runs upstream-and-back loops at race pace and Makes good use of the 1KM striaght
          on the stretch, ensuring rowers arrive race ready for the biggest competitions.
        </p>
      </div>
    </Container>
  </Section>

  {/* Live conditions — river level + 24h weather */}
  <ConditionsPanel lat={lat} lng={lng} />

  <Section spacing="md">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <Eyebrow>Facilities</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">What's on site.</h2>
          <ul class="mt-6 space-y-4 text-(--color-ink)">
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-(--color-gold) flex-shrink-0"></span>
              <span>
                <strong class="font-display">Boat hall</strong> housing the senior eights, fours, pairs,
                sculling fleet, and reserve boats.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-(--color-gold) flex-shrink-0"></span>
              <span>
                <strong class="font-display">Landing stage onto the reach</strong> — crews go from rack
                to water in minutes, straight out onto the Bath–Saltford stretch.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-(--color-gold) flex-shrink-0"></span>
              <span>
                <strong class="font-display">Rigging &amp; maintenance bay</strong> — riggers, blades,
                spares and the tools to keep a full racing fleet on the water.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-(--color-gold) flex-shrink-0"></span>
              <span>
                <strong class="font-display">Club trailer &amp; boat park</strong> — loaded on site for
                away regattas and head races up and down the country.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-(--color-gold) flex-shrink-0"></span>
              <span>
                <strong class="font-display">Changing rooms &amp; kit store</strong> — secure storage
                for kit and personal effects during sessions.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-(--color-gold) flex-shrink-0"></span>
              <span>
                <strong class="font-display">Coach launches and bank-bikes</strong> for technical coaching
                the whole length of the reach.
              </span>
            </li>
          </ul>
          <p class="mt-6 text-sm text-(--color-mute) leading-relaxed">
            Ergs and weights aren't on the riverbank — land training runs on campus at the
            University's
            <a
              href="#stv"
              class="underline decoration-(--color-gold) underline-offset-4 hover:text-(--color-gold-text)"
              >Sports Training Village</a
            >, a few minutes from the boathouse.
          </p>
        </div>

        <aside class="bg-(--color-bone) p-6 sm:p-8">
          <Eyebrow>Find us</Eyebrow>
          <h3 class="mt-3 font-display text-2xl">Boathouse map.</h3>
          <p class="mt-3 text-sm text-(--color-mute)">
            Park in the Newbridge Park and Ride car park and walk down the short track to the
            boathouse, there's no parking on the riverbank itself.
          </p>
          <div class="mt-5 border border-(--color-ink)/15">
            <iframe
              src={mapSrc}
              title="Map showing the BUBC boathouse location"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="block w-full h-72"></iframe>
          </div>
          <p class="mt-3 text-xs text-(--color-mute)">
            <a
              href={`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=16/${lat}/${lng}`}
              class="underline decoration-(--color-gold) underline-offset-4"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open on OpenStreetMap
            </a>
            ·
            <a
              href={`https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`}
              class="underline decoration-(--color-gold) underline-offset-4"
              target="_blank"
              rel="noopener noreferrer"
            >
              Directions
            </a>
            {
              settings?.boathouseLocation?.what3words && (
                <>
                  · <span>///{settings.boathouseLocation.what3words}</span>
                </>
              )
            }
          </p>
        </aside>
      </div>

      {
        settings?.boathousePhotos && settings.boathousePhotos.length > 0 && (
          <div class="mt-14 lg:mt-16">
            <Eyebrow>The boathouse</Eyebrow>
            <h3 class="mt-3 font-display text-2xl sm:text-3xl">On the riverbank.</h3>
            <div class="mt-8">
              <PhotoGallery images={settings.boathousePhotos} />
            </div>
          </div>
        )
      }
    </Container>
  </Section>

  {/* New boathouse — capital project */}
  <Section tone="navy" spacing="md">
    <Container>
      <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-start text-(--color-paper)">
        <div>
          <Eyebrow tone="paper">Capital project</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">A new boathouse, built.</h2>
          <div class="mt-6 space-y-5 leading-relaxed text-(--color-paper)/90">
            <p>
              For the first time since the 1990s, BUBC has built a new boathouse. The capital
              project, backed by the University and the alumni community, replaces the old facility
              with a purpose-built club home.
            </p>
            <p>
              The new boathouse was not a vanity project. It answered a real constraint — the fleet
              had outgrown the building that housed it, and the next decade of BUBC rowing depends
              on getting that right.
            </p>
            <p>
              The build is complete, and the squad will be rowing out of it from the upcoming
              season. Donations to the capital campaign are routed through the Boat Club Capital
              Campaign.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="/support/campaigns/" variant="gold">Support the campaign</Button>
            <Button
              href="/news/"
              variant="ghost"
              class="!border-(--color-paper) !text-(--color-paper) hover:!bg-(--color-paper) hover:!text-(--color-ink)"
            >
              Latest updates
            </Button>
          </div>
        </div>
        <aside class="bg-(--color-paper)/5 border border-(--color-paper)/20 p-6 sm:p-8">
          <Eyebrow tone="paper">Why it matters</Eyebrow>
          <dl class="mt-5 space-y-5 text-(--color-paper)/90">
            <div>
              <dt class="font-display text-lg text-(--color-paper)">More fleet, on site.</dt>
              <dd class="mt-1 text-sm leading-relaxed">
                Storage for the senior eights, the development fleet, and a sculling rotation that
                doesn't depend on shuffling boats between clubs.
              </dd>
            </div>
            <div>
              <dt class="font-display text-lg text-(--color-paper)">Coaching room.</dt>
              <dd class="mt-1 text-sm leading-relaxed">
                Dedicated space for video review, crew meetings and selection conversations away
                from the bay.
              </dd>
            </div>
            <div>
              <dt class="font-display text-lg text-(--color-paper)">Alumni &amp; family area.</dt>
              <dd class="mt-1 text-sm leading-relaxed">
                A proper home base on race weekends — instead of the old arrangement, which was "the
                lawn, plus an umbrella, in November."
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  {/* Land training at the STV */}
  <Section spacing="md">
    <Container>
      <div class="max-w-2xl">
        <Eyebrow>Strength &amp; conditioning</Eyebrow>
        <h2 id="stv" class="mt-4 font-display text-3xl sm:text-4xl scroll-mt-28">
          Land training at the STV.
        </h2>
        <p class="mt-4 text-(--color-mute) leading-relaxed">
          On campus, the Sports Training Village (STV) gives BUBC athletes access to one of the best
          university training facilities in the country. Land sessions run out of two STV spaces —
          the high-performance gym, and a dedicated indoor rowing room.
        </p>
      </div>
      <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-8">
        <li>
          <h3 class="font-display text-lg">High-performance gym</h3>
          <p class="mt-2 text-sm text-(--color-mute) leading-relaxed">
            Olympic lifting platforms and bumper-plate range. Shared with Team Bath performance
            squads and supported by qualified S&amp;C staff who write squad-specific programmes.
          </p>
        </li>
        <li>
          <h3 class="font-display text-lg">Indoor rowing room</h3>
          <p class="mt-2 text-sm text-(--color-mute) leading-relaxed">
            Concept2 RowErg and dynamic ergometer stable. Where the senior squad does its row
            pieces, technical work and the long aerobic sessions that don't belong on the river.
          </p>
        </li>
        <li>
          <h3 class="font-display text-lg">Testing &amp; recovery</h3>
          <p class="mt-2 text-sm text-(--color-mute) leading-relaxed">
            Strength testing protocols aligned to the British Rowing performance framework.
            Physiotherapy, soft-tissue and recovery services on the same campus.
          </p>
        </li>
      </ul>

      {
        settings?.stvPhotos && settings.stvPhotos.length > 0 && (
          <div class="mt-12">
            <PhotoGallery images={settings.stvPhotos} />
          </div>
        )
      }
    </Container>
  </Section>

  {/* Fleet teaser */}
  <Section tone="bone" spacing="md">
    <Container>
      <div class="flex items-end justify-between gap-6 flex-wrap">
        <div class="max-w-2xl">
          <Eyebrow>The fleet</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">Boats with names.</h2>
          <p class="mt-4 text-(--color-mute)">
            Every BUBC racing shell carries a name and a story — donors, christenings, crews. A
            taste of the current fleet below; browse the full fleet for each boat's profile.
          </p>
        </div>
        <a
          href="/boathouse/fleet/"
          class="hidden sm:inline-flex items-center gap-2 text-sm font-medium tracking-wide hover:text-(--color-gold-text)"
        >
          View the full fleet
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        fleetTeaser.length > 0 ? (
          <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {fleetTeaser.map((boat) => (
              <li>
                <article class="group relative flex flex-col">
                  <a
                    href={`/boathouse/fleet/${boat.slug}/`}
                    class="absolute inset-0 z-10"
                    aria-label={`${boat.name} — full profile`}
                  />
                  <Picture
                    image={boat.photo}
                    ratio="4/5"
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    fallbackLabel={boat.name}
                    class="transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                  <div class="mt-4">
                    <h3 class="font-display text-xl group-hover:underline decoration-(--color-gold) underline-offset-4">
                      {boat.name}
                    </h3>
                    <p class="mt-1 text-sm text-(--color-mute)">
                      {boat.make} · {boat.class}
                      {boat.yearBought ? ` · ${boat.yearBought}` : ''}
                    </p>
                    {boat.donor && (
                      <p class="mt-2 text-xs uppercase tracking-[0.12em] text-(--color-gold-text)">
                        Donated by {boat.donor}
                      </p>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-8 italic text-(--color-mute)">
            Fleet profiles will be published as boat-by-boat photography is completed. The full
            fleet directory is at{' '}
            <a href="/boathouse/fleet/" class="underline">
              /boathouse/fleet/
            </a>
            .
          </p>
        )
      }

      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/boathouse/fleet/" variant="solid">View the fleet</Button>
        <Button href="/support/buy-a-boat/" variant="ghost">Buy a boat</Button>
        <Button href="/support/donate/" variant="ghost">Support the fleet</Button>
      </div>
    </Container>
  </Section>
</PageLayout>
