---
/**
 * Campaigns index — /support/campaigns/
 *
 * Listing of every campaign (active, reached, closed). Active campaigns lead
 * with the thermometer; reached/closed render as a historical record without
 * a donate CTA.
 */
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/layout/PageHero.astro';
import Container from '../../../components/ui/Container.astro';
import Section from '../../../components/ui/Section.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import Button from '../../../components/ui/Button.astro';
import Picture from '../../../components/content/Picture.astro';
import DonationThermometer from '../../../components/support/DonationThermometer.astro';
import JsonLd from '../../../components/seo/JsonLd.astro';
import { safeFetch } from '../../../lib/sanity';
import { allCampaignsQuery } from '../../../lib/queries';
import { SITE } from '../../../lib/seo';
import { ogImage } from '../../../lib/og/url';
import type { CampaignData } from '../../../lib/types';

const campaigns = (await safeFetch<CampaignData[]>(allCampaignsQuery)) ?? [];

const active = campaigns.filter((c) => c.status === 'active');
const reached = campaigns.filter((c) => c.status === 'reached');
const closed = campaigns.filter((c) => c.status === 'closed' || !c.status);

const statusLabel: Record<NonNullable<CampaignData['status']>, string> = {
  active: 'Active',
  reached: 'Goal reached',
  closed: 'Closed',
};

const HUBBUB_URL = 'https://bath.hubbub.net/p/BUBC/pledge/';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Support', item: `${SITE.url}/support/` },
    { '@type': 'ListItem', position: 3, name: 'Campaigns', item: `${SITE.url}/support/campaigns/` },
  ],
};
---

<PageLayout
  seo={{
    title: 'Campaigns',
    description:
      'Active and past fundraising campaigns at the University of Bath Boat Club. Boats, training camps, alumni events.',
    image: ogImage({ kind: 'page', slug: 'campaigns' }),
  }}
>
  <JsonLd data={breadcrumbs} slot="head" />

  <PageHero
    eyebrow="Support"
    headline="What we're raising for."
    lead="Each campaign funds a specific thing — a new shell, a training camp, an alumni initiative. Live progress, transparent goals."
  />

  <Section spacing="md">
    <Container>
      <p class="text-sm text-(--color-mute) mb-10">
        <a href="/support/" class="hover:text-(--color-navy)">Support</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-(--color-ink)">Campaigns</span>
      </p>

      {
        campaigns.length === 0 ? (
          <div class="rounded border border-dashed border-(--color-ink)/15 bg-(--color-bone)/60 p-10 text-center max-w-2xl mx-auto">
            <Eyebrow>Campaigns</Eyebrow>
            <h2 class="mt-3 font-display text-2xl">No campaigns running right now</h2>
            <p class="mt-3 text-sm text-(--color-mute)">
              One-off donations via Hubbub still go directly to the club's operating fund — and
              that's the most flexible support you can give.
            </p>
            <div class="mt-6">
              <Button href={HUBBUB_URL} variant="solid" external>
                Donate via Hubbub
              </Button>
            </div>
          </div>
        ) : (
          <>
            {active.length > 0 && (
              <div>
                <Eyebrow>Now</Eyebrow>
                <h2 class="mt-3 font-display text-3xl sm:text-4xl">Active campaigns.</h2>
                <ul class="mt-10 grid lg:grid-cols-2 gap-10">
                  {active.map((c) => (
                    <li>
                      <article class="group relative flex flex-col bg-(--color-bone)">
                        <a
                          href={`/support/campaigns/${c.slug}/`}
                          class="absolute inset-0 z-10"
                          aria-label={`${c.title} — full story`}
                        />
                        <Picture
                          image={c.heroImage}
                          ratio="3/2"
                          sizes="(min-width: 1024px) 50vw, 100vw"
                          fallbackLabel={c.title}
                          class="transition-transform duration-500 group-hover:scale-[1.02]"
                        />
                        <div class="p-6 sm:p-8 flex flex-col gap-5">
                          <div>
                            <span class="inline-flex items-center rounded-sm bg-(--color-navy) text-(--color-paper) px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.12em]">
                              {statusLabel.active}
                            </span>
                            <h3 class="mt-3 font-display text-2xl group-hover:underline decoration-(--color-gold) underline-offset-4">
                              {c.title}
                            </h3>
                            <p class="mt-2 text-(--color-mute)">{c.shortDescription}</p>
                          </div>
                          <DonationThermometer
                            goal={c.goalAmount}
                            raised={c.raisedAmount}
                            donorCount={c.donorCount}
                          />
                        </div>
                      </article>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {reached.length > 0 && (
              <div class="mt-20">
                <Eyebrow>Goal reached</Eyebrow>
                <h2 class="mt-3 font-display text-3xl">Funded campaigns.</h2>
                <ul class="mt-8 divide-y divide-(--color-ink)/10 border-y border-(--color-ink)/10">
                  {reached.map((c) => (
                    <li>
                      <a
                        href={`/support/campaigns/${c.slug}/`}
                        class="group block py-5 hover:bg-(--color-bone)/40 -mx-4 px-4 transition-colors"
                      >
                        <div class="flex items-baseline justify-between gap-6 flex-wrap">
                          <div>
                            <h3 class="font-display text-xl group-hover:underline decoration-(--color-gold) underline-offset-4">
                              {c.title}
                            </h3>
                            <p class="mt-1 text-sm text-(--color-mute)">{c.shortDescription}</p>
                          </div>
                          <span class="text-xs uppercase tracking-[0.12em] text-(--color-gold) font-medium">
                            {statusLabel.reached}
                          </span>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {closed.length > 0 && (
              <div class="mt-20">
                <Eyebrow>Archive</Eyebrow>
                <h2 class="mt-3 font-display text-3xl">Past campaigns.</h2>
                <ul class="mt-8 divide-y divide-(--color-ink)/10 border-y border-(--color-ink)/10">
                  {closed.map((c) => (
                    <li>
                      <a
                        href={`/support/campaigns/${c.slug}/`}
                        class="group block py-4 hover:bg-(--color-bone)/40 -mx-4 px-4 transition-colors"
                      >
                        <div class="flex items-baseline justify-between gap-6 flex-wrap">
                          <h3 class="font-display text-lg group-hover:underline decoration-(--color-gold) underline-offset-4">
                            {c.title}
                          </h3>
                          <span class="text-xs uppercase tracking-[0.12em] text-(--color-mute)">
                            {statusLabel.closed}
                          </span>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </>
        )
      }
    </Container>
  </Section>
</PageLayout>
