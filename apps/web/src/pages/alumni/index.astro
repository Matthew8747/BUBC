---
/**
 * Alumni landing — /alumni/
 *
 * Unified "where they are now" grid for all alumni-profile categories
 * (olympian, international, boatRace, notableCareer). Filter pills at the
 * top toggle category visibility; the underlying HTML is server-rendered
 * and works without JS.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import Picture from '../../components/content/Picture.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { safeFetch } from '../../lib/sanity';
import { alumniProfilesQuery } from '../../lib/queries';
import { SITE } from '../../lib/seo';
import { ogImage } from '../../lib/og/url';
import type { AlumniProfileCard, AlumniCategory, Medal } from '../../lib/types';

const profiles = (await safeFetch<AlumniProfileCard[]>(alumniProfilesQuery)) ?? [];

const categoryLabel: Record<AlumniCategory, string> = {
  olympian: 'Olympian',
  international: 'GB / International',
  boatRace: 'Boat Race blue',
  notableCareer: 'Notable career',
};

const categoryFilters: { id: 'all' | AlumniCategory; label: string }[] = [
  { id: 'all', label: 'All alumni' },
  { id: 'olympian', label: 'Olympians' },
  { id: 'international', label: 'GB / International' },
  { id: 'boatRace', label: 'Boat Race' },
  { id: 'notableCareer', label: 'Notable careers' },
];

const counts = profiles.reduce<Record<string, number>>((acc, p) => {
  const k = p.category ?? 'olympian';
  acc[k] = (acc[k] ?? 0) + 1;
  return acc;
}, {});

// One-line summary per profile depending on category — keeps the card honest.
function summarise(p: AlumniProfileCard): string {
  switch (p.category) {
    case 'international':
      if (p.internationalAppearances?.length) {
        const first = p.internationalAppearances[0];
        return [first.team, first.event].filter(Boolean).join(' · ');
      }
      return 'GB / international representation';
    case 'boatRace':
      if (p.boatRaceAppearances?.length) {
        const first = p.boatRaceAppearances[0];
        const uni = first.university === 'oxford' ? 'Oxford' : 'Cambridge';
        return `${uni} ${first.boat === 'reserves' ? 'reserves' : 'blue'} (${first.year})`;
      }
      return 'Boat Race blue';
    case 'notableCareer':
      return p.careerHighlight ?? 'Notable career';
    default:
      if (p.olympicYears?.length) {
        const years = p.olympicYears.map((o) => o.year).join(', ');
        return `Olympics ${years}`;
      }
      return 'Olympian';
  }
}

function bestMedal(p: AlumniProfileCard): Medal | null {
  const all = [...(p.olympicYears ?? []), ...(p.internationalAppearances ?? [])]
    .map((a) => a.medal)
    .filter((m): m is Medal => m === 'gold' || m === 'silver' || m === 'bronze');
  if (!all.length) return null;
  if (all.includes('gold')) return 'gold';
  if (all.includes('silver')) return 'silver';
  return 'bronze';
}

const medalTone: Record<Medal, string> = {
  gold: 'bg-(--color-gold) text-(--color-ink)',
  silver: 'bg-[#C0C0C0] text-(--color-ink)',
  bronze: 'bg-[#A97142] text-(--color-paper)',
  none: '',
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Alumni', item: `${SITE.url}/alumni/` },
  ],
};
---

<PageLayout
  seo={{
    title: 'Alumni',
    description:
      'BUBC alumni — Olympians, GB internationals, Boat Race blues, and notable careers. The wider rowing family.',
    image: ogImage({ kind: 'page', slug: 'alumni' }),
  }}
>
  <JsonLd data={breadcrumbs} slot="head" />

  <PageHero
    eyebrow="Alumni"
    headline="Where they are now."
    lead="Bath rowers don't disappear after graduation. The wider BUBC family includes Olympians, international team rowers, Boat Race blues, and a long list of careers built on what was learned on the river."
    ctas={[
      {
        label: 'Meles Boat Club',
        variant: 'gold',
        link: { label: 'Meles', url: '/alumni/meles/' },
      },
      {
        label: 'Alumni events',
        variant: 'ghost',
        link: { label: 'Events', url: '/alumni/events/' },
      },
    ]}
  />

  <Section spacing="md">
    <Container>
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-16">
        <div class="lg:col-span-2">
          <Eyebrow>Profiles</Eyebrow>
          <h2 class="mt-3 font-display text-3xl sm:text-4xl">The wider club.</h2>
          <p class="mt-4 text-(--color-mute)">
            Filter by category. Each profile is published with the alumnus's input — if you raced
            for Bath and we don't have you yet, please get in touch:{' '}
            <a
              class="underline decoration-(--color-gold) underline-offset-4"
              href="mailto:alumni@bubc.co.uk"
            >
              alumni@bubc.co.uk
            </a>
            .
          </p>
        </div>

        <aside class="bg-(--color-bone) p-6">
          <h3 class="font-display text-lg">Quick links</h3>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <a class="hover:text-(--color-gold)" href="/alumni/meles/">
                Meles Boat Club (alumni rowing) →
              </a>
            </li>
            <li>
              <a class="hover:text-(--color-gold)" href="/alumni/events/">
                Alumni dinners and events →
              </a>
            </li>
            <li>
              <a class="hover:text-(--color-gold)" href="/about/olympians/">
                Olympic honours roll →
              </a>
            </li>
            <li>
              <a class="hover:text-(--color-gold)" href="/about/henley-honours/">
                Henley honours →
              </a>
            </li>
            <li>
              <a class="hover:text-(--color-gold)" href="/about/chairs/"> Past chairs → </a>
            </li>
            <li>
              <a class="hover:text-(--color-gold)" href="/support/donate/"> Donate → </a>
            </li>
          </ul>
        </aside>
      </div>

      <div class="mt-12 flex flex-wrap gap-2" role="group" aria-label="Filter alumni by category">
        {
          categoryFilters.map((f) => {
            const c = f.id === 'all' ? profiles.length : (counts[f.id] ?? 0);
            return (
              <button
                type="button"
                class="alumni-filter inline-flex items-center gap-2 rounded-full border border-(--color-ink)/15 bg-(--color-paper) px-3.5 py-1.5 text-xs font-medium uppercase tracking-[0.1em] hover:border-(--color-ink)/30 aria-pressed:bg-(--color-ink) aria-pressed:text-(--color-paper) aria-pressed:border-(--color-ink)"
                data-filter={f.id}
                aria-pressed={f.id === 'all' ? 'true' : 'false'}
              >
                <span>{f.label}</span>
                {profiles.length > 0 && <span class="opacity-60 normal-case text-[10px]">{c}</span>}
              </button>
            );
          })
        }
      </div>

      {
        profiles.length > 0 ? (
          <>
            <ul class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14" id="alumni-grid">
              {profiles.map((p, i) => {
                const medal = bestMedal(p);
                const cat = p.category ?? 'olympian';
                const href =
                  cat === 'olympian' ? `/about/olympians/${p.slug}/` : `/alumni/profile/${p.slug}/`;
                return (
                  <li data-category={cat}>
                    <article class="group relative flex flex-col">
                      <a
                        href={href}
                        class="absolute inset-0 z-10"
                        aria-label={`${p.name} — full profile`}
                      >
                        <span class="sr-only">Profile</span>
                      </a>
                      <div class="relative">
                        <Picture
                          image={p.photo}
                          ratio="4/5"
                          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                          fallbackLabel={p.name}
                          priority={i < 3}
                          class="transition-transform duration-500 group-hover:scale-[1.02]"
                        />
                        {medal && (
                          <span
                            class:list={[
                              'absolute top-3 left-3 inline-flex h-7 items-center rounded-full px-3 text-[10px] font-medium uppercase tracking-[0.12em]',
                              medalTone[medal],
                            ]}
                          >
                            {medal} medallist
                          </span>
                        )}
                      </div>
                      <div class="mt-4">
                        <p class="text-[10px] uppercase tracking-[0.14em] text-(--color-gold)">
                          {categoryLabel[cat]}
                        </p>
                        <h3 class="mt-1 font-display text-2xl group-hover:underline decoration-(--color-gold) underline-offset-4">
                          {p.name}
                        </h3>
                        <p class="mt-1 text-sm text-(--color-mute)">{summarise(p)}</p>
                        {(p.bubcYears || p.currentRole) && (
                          <p class="mt-2 text-xs text-(--color-mute)">
                            {p.bubcYears && <span>BUBC {p.bubcYears}</span>}
                            {p.bubcYears && p.currentRole && <span class="mx-2 opacity-50">·</span>}
                            {p.currentRole && <span class="italic">{p.currentRole}</span>}
                          </p>
                        )}
                      </div>
                    </article>
                  </li>
                );
              })}
            </ul>

            <p
              class="mt-12 hidden italic text-(--color-mute)"
              id="alumni-empty-filter"
              role="status"
              aria-live="polite"
            >
              No profiles in this category yet — get in touch if you should be listed:{' '}
              <a class="underline" href="mailto:alumni@bubc.co.uk">
                alumni@bubc.co.uk
              </a>
              .
            </p>
          </>
        ) : (
          <div class="mt-10 rounded border border-dashed border-(--color-ink)/15 bg-(--color-bone)/60 p-10 text-center max-w-2xl mx-auto">
            <h2 class="font-display text-2xl">Alumni outreach is underway</h2>
            <p class="mt-3 text-sm text-(--color-mute)">
              We're building the alumni archive one profile at a time, with each alumnus's input.
              The first published profiles will appear here. If you raced for Bath and would like to
              be listed, please email{' '}
              <a
                class="underline decoration-(--color-gold) underline-offset-4"
                href="mailto:alumni@bubc.co.uk"
              >
                alumni@bubc.co.uk
              </a>
              .
            </p>
            <div class="mt-6 flex flex-wrap gap-3 justify-center">
              <Button href="/alumni/meles/" variant="ghost">
                Meles BC
              </Button>
              <Button href="/alumni/events/" variant="solid">
                Events
              </Button>
            </div>
          </div>
        )
      }
    </Container>
  </Section>
</PageLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.alumni-filter');
  const grid = document.getElementById('alumni-grid');
  const emptyMsg = document.getElementById('alumni-empty-filter');

  function applyFilter(filter: string) {
    if (!grid) return;
    let visible = 0;
    grid.querySelectorAll<HTMLElement>('[data-category]').forEach((li) => {
      const match = filter === 'all' || li.dataset.category === filter;
      li.hidden = !match;
      if (match) visible++;
    });
    if (emptyMsg) emptyMsg.hidden = visible !== 0;
  }

  pills.forEach((btn) => {
    btn.addEventListener('click', () => {
      pills.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      applyFilter(btn.dataset.filter ?? 'all');
    });
  });
</script>
