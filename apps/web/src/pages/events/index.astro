---
/**
 * Events — /events/
 *
 * The club's "what's on": every upcoming event (regattas, heads, camps,
 * socials, fundraisers, alumni) in one chronological list, plus a short
 * archive of recent past events. Reads the shared `event` schema. Not a
 * calendar grid by design — just a clear, scannable list of what's next.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import Picture from '../../components/content/Picture.astro';
import PortableText from '../../components/content/PortableText.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { safeFetch } from '../../lib/sanity';
import { upcomingEventsQuery, pastEventsQuery } from '../../lib/queries';
import { SITE } from '../../lib/seo';
import { ogImage } from '../../lib/og/url';
import type { EventCardData, EventType } from '../../lib/types';

const today = new Date().toISOString().slice(0, 10);

const [upcoming, past] = await Promise.all([
  safeFetch<EventCardData[]>(upcomingEventsQuery, { today }),
  safeFetch<EventCardData[]>(pastEventsQuery, { today }),
]);

const eventList = upcoming ?? [];
const pastList = past ?? [];

const typeLabels: Record<EventType, string> = {
  regatta: 'Regatta',
  head: 'Head race',
  camp: 'Training camp',
  social: 'Social',
  alumni: 'Alumni',
  fundraiser: 'Fundraiser',
};

function fmtDate(iso?: string): string {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

function dateRange(start?: string, end?: string): string {
  if (!start) return '';
  const s = fmtDate(start);
  if (!end || end === start) return s;
  return `${s} – ${fmtDate(end)}`;
}

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Events', item: `${SITE.url}/events/` },
  ],
};

const eventJsonLd = eventList.length
  ? {
      '@context': 'https://schema.org',
      '@graph': eventList.map((e) => ({
        '@type': 'Event',
        name: e.title,
        startDate: e.date,
        ...(e.endDate ? { endDate: e.endDate } : {}),
        ...(e.location ? { location: { '@type': 'Place', name: e.location } } : {}),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        organizer: { '@type': 'Organization', name: SITE.name, url: SITE.url },
        url: `${SITE.url}/events/`,
      })),
    }
  : null;
---

<PageLayout
  seo={{
    title: 'Events',
    description:
      'Upcoming events at the University of Bath Boat Club — regattas, head races, training camps, socials, and fundraisers. What the club has on next.',
    image: ogImage({ kind: 'page', slug: 'events' }),
  }}
>
  <JsonLd data={breadcrumbs} slot="head" />
  {eventJsonLd && <JsonLd data={eventJsonLd} slot="head" />}

  <PageHero
    eyebrow="Events"
    headline="What's on."
    lead="Regattas, head races, training camps, socials and fundraisers — everything the club has coming up, soonest first."
  />

  <Section spacing="md">
    <Container>
      <Eyebrow>Upcoming</Eyebrow>
      <h2 class="mt-3 font-display text-3xl sm:text-4xl">What's next.</h2>

      {
        eventList.length === 0 ? (
          <p class="mt-8 italic text-(--color-mute) max-w-2xl">
            Nothing on the calendar at the moment — the race programme is usually confirmed term by
            term. Check the{' '}
            <a class="underline decoration-(--color-gold) underline-offset-4" href="/news/">
              latest news
            </a>{' '}
            or follow{' '}
            <a
              class="underline decoration-(--color-gold) underline-offset-4"
              href="https://instagram.com/crewbath_"
              target="_blank"
              rel="noopener noreferrer"
            >
              @crewbath_
            </a>{' '}
            for fixtures as they're announced.
          </p>
        ) : (
          <ul class="mt-10 grid lg:grid-cols-2 gap-10">
            {eventList.map((e) => (
              <li>
                <article class="flex flex-col bg-(--color-bone) h-full">
                  <Picture
                    image={e.heroImage}
                    ratio="3/2"
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    fallbackLabel={e.title}
                  />
                  <div class="p-6 sm:p-8 flex flex-col gap-4 flex-1">
                    <div class="flex items-center gap-3 flex-wrap">
                      {e.type && (
                        <span class="inline-flex items-center rounded-sm bg-(--color-navy) text-(--color-paper) px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.12em]">
                          {typeLabels[e.type] ?? e.type}
                        </span>
                      )}
                      <p class="text-xs uppercase tracking-[0.14em] text-(--color-gold) font-medium tabular-nums">
                        {dateRange(e.date, e.endDate)}
                      </p>
                    </div>
                    <h3 class="font-display text-2xl">{e.title}</h3>
                    {e.location && <p class="text-sm text-(--color-mute)">{e.location}</p>}
                    {e.description != null && (
                      <div class="text-sm">
                        <PortableText value={e.description} />
                      </div>
                    )}
                    {e.registerUrl && (
                      <div class="mt-auto pt-2">
                        <Button
                          href={e.registerUrl}
                          variant="solid"
                          external={!e.registerUrl.startsWith('mailto:')}
                        >
                          {e.registerUrl.startsWith('mailto:') ? 'RSVP by email' : 'Register'}
                        </Button>
                      </div>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </Container>
  </Section>

  {
    pastList.length > 0 && (
      <Section tone="bone" spacing="md">
        <Container>
          <Eyebrow>Recent</Eyebrow>
          <h2 class="mt-3 font-display text-3xl">Just gone.</h2>
          <ul class="mt-8 divide-y divide-(--color-ink)/10 border-y border-(--color-ink)/10">
            {pastList.map((e) => (
              <li class="py-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <p class="font-display text-lg">
                  {e.type && (
                    <span class="text-xs uppercase tracking-[0.12em] text-(--color-mute) mr-3">
                      {typeLabels[e.type] ?? e.type}
                    </span>
                  )}
                  {e.title}
                </p>
                <p class="text-sm text-(--color-mute) tabular-nums">
                  {fmtDate(e.date)}
                  {e.location && <span class="mx-2 opacity-50">·</span>}
                  {e.location && <span>{e.location}</span>}
                </p>
              </li>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }
</PageLayout>
