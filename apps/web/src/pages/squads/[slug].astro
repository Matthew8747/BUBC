---
/**
 * Squad detail — per-squad public page.
 *
 * Build-time strategy:
 *   1. Fetch every squad slug from Sanity to build static paths.
 *   2. For each, fetch the full document to compose the page.
 *
 * When Sanity has no squads (early development) we fall back to a fixed set
 * of placeholder slugs (senior-men / senior-women / novice) so the page
 * structure is still navigable and indexable for early link-checkers.
 */
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import Picture from '../../components/content/Picture.astro';
import PortableText from '../../components/content/PortableText.astro';
import PhotoGallery from '../../components/content/PhotoGallery.astro';
import TrainingScheduleTable from '../../components/squad/TrainingScheduleTable.astro';
import CoachStrip from '../../components/squad/CoachStrip.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { safeFetch } from '../../lib/sanity';
import { allSquadSlugsQuery, squadBySlugQuery } from '../../lib/queries';
import { ogImage } from '../../lib/og/url';
import { SITE } from '../../lib/seo';
import type { SquadDetail } from '../../lib/types';

export const getStaticPaths = (async () => {
  const slugs = (await safeFetch<{ slug: string }[]>(allSquadSlugsQuery)) ?? [];
  const real = slugs.map((s) => s.slug).filter(Boolean);
  const fallback = ['senior-men', 'senior-women', 'novice'];
  const all = real.length > 0 ? real : fallback;
  return all.map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const data = (await safeFetch<SquadDetail>(squadBySlugQuery, { slug })) ?? null;

// Sensible placeholder so the page renders before Sanity content lands.
const placeholderName: Record<string, string> = {
  'senior-men': 'Senior men',
  'senior-women': 'Senior women',
  novice: 'Novice',
};

const name = data?.name ?? placeholderName[slug ?? ''] ?? 'Squad';
const tier = data?.tier ?? 'senior';
const gender = data?.gender;
const lead =
  data?.shortDescription ??
  "Programme details will be published once the captain and coaches confirm the season's training plan.";

const seo = {
  title: data?.seo?.title ?? name,
  description: data?.seo?.description ?? lead,
  noIndex: data?.seo?.noIndex,
  image:
    data?.seo?.image?.asset?.url ??
    data?.heroImage?.asset?.url ??
    ogImage({ kind: 'squad', slug: slug ?? 'squads' }),
};

const tierLabel = `${tier}${gender && gender !== 'mixed' ? ` · ${gender}` : ''}`;

const captains = data?.captains ?? [];
const hasMultipleCaptains = captains.length > 1;
const captainEyebrow = hasMultipleCaptains ? 'Captains' : 'Captain';
const emailCaptainLabel = hasMultipleCaptains ? 'Email the captains' : 'Email the captain';

const sortedAchievements = (data?.achievements ?? []).slice().sort((a, b) => b.year - a.year);

const sortedRecentResults = (data?.recentResults ?? [])
  .slice()
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

const resultDateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const formatResultDate = (iso?: string) => {
  if (!iso) return '';
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? iso : resultDateFmt.format(d);
};
const resultHref = (r: (typeof sortedRecentResults)[number]) =>
  r.raceReport?.slug ? `/news/${r.raceReport.slug}/` : r.externalUrl;

const squadJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  name: `BUBC ${name}`,
  sport: 'Rowing',
  url: `${SITE.url}/squads/${slug}/`,
  parentOrganization: {
    '@type': 'SportsOrganization',
    name: SITE.name,
    url: SITE.url,
  },
  ...(gender
    ? { gender: gender === 'mixed' ? 'Mixed' : gender === 'men' ? 'Male' : 'Female' }
    : {}),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Squads', item: `${SITE.url}/squads/` },
    { '@type': 'ListItem', position: 3, name, item: `${SITE.url}/squads/${slug}/` },
  ],
};
---

<PageLayout seo={seo}>
  <JsonLd data={squadJsonLd} slot="head" />
  <JsonLd data={breadcrumbJsonLd} slot="head" />
  <PageHero
    eyebrow={tierLabel}
    headline={name}
    lead={lead}
    image={data?.heroImage}
    ctas={[
      {
        label: 'Trial with us',
        variant: 'gold',
        link: { label: 'Trial', url: '/squads/trial/' },
      },
      ...(data?.contactEmail
        ? [
            {
              label: emailCaptainLabel,
              variant: 'ghost' as const,
              link: {
                label: 'Email',
                url: `mailto:${data.contactEmail}`,
                external: true,
              },
            },
          ]
        : []),
    ]}
  />

  {/* Captain callout */}
  {
    data?.captainBio && (
      <Section spacing="md">
        <Container width="narrow">
          <div class="border-l-2 border-(--color-gold) pl-6 sm:pl-8 py-2">
            <Eyebrow>{captainEyebrow}</Eyebrow>
            {captains.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-x-8 gap-y-4">
                {captains.map((c) => (
                  <div class="flex items-center gap-4">
                    <div class="h-14 w-14 overflow-hidden rounded-full flex-shrink-0">
                      <Picture
                        image={c.photo}
                        ratio="1/1"
                        sizes="56px"
                        fallbackLabel={c.name
                          .split(' ')
                          .map((p) => p[0])
                          .join('')}
                        class="h-14 w-14"
                      />
                    </div>
                    <div>
                      <p class="font-display text-xl leading-tight">{c.name}</p>
                      {c.role && <p class="text-sm text-(--color-mute)">{c.role}</p>}
                    </div>
                  </div>
                ))}
              </div>
            )}
            <p class="mt-5 text-lg leading-relaxed">{data.captainBio}</p>
          </div>
        </Container>
      </Section>
    )
  }

  {/* Training schedule — paragraph if the captain supplied one, otherwise the table */}
  <Section tone="bone" spacing="md">
    <Container width="narrow">
      <Eyebrow>Training week</Eyebrow>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl">A typical week.</h2>
      <p class="mt-3 text-(--color-mute)">
        Sessions are mandatory unless a captain or coach signs you off. Times shift slightly term by
        term — confirmed at the start of each term.
      </p>
      <div class="mt-8">
        {
          data?.trainingNarrative ? (
            <div class="max-w-2xl text-lg leading-relaxed whitespace-pre-line">
              {data.trainingNarrative}
            </div>
          ) : (
            <TrainingScheduleTable sessions={data?.trainingSchedule} />
          )
        }
      </div>
    </Container>
  </Section>

  {/* Expected standards */}
  {
    data?.expectedStandards != null && (
      <Section spacing="md">
        <Container width="narrow">
          <Eyebrow>Expected standards</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">What we ask of you.</h2>
          <div class="mt-6">
            <PortableText value={data.expectedStandards} />
          </div>
        </Container>
      </Section>
    )
  }

  {/* Coaches */}
  {
    data?.coaches && data.coaches.length > 0 && (
      <Section tone="bone" spacing="md">
        <Container>
          <div class="max-w-2xl">
            <Eyebrow>Coaching</Eyebrow>
            <h2 class="mt-4 font-display text-3xl sm:text-4xl">Who you'll work with.</h2>
          </div>
          <div class="mt-10">
            <CoachStrip coaches={data.coaches} />
          </div>
        </Container>
      </Section>
    )
  }

  {/* Recent results */}
  {
    sortedRecentResults.length > 0 && (
      <Section spacing="md">
        <Container width="narrow">
          <Eyebrow>Recent results</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">On the water lately.</h2>
          <p class="mt-3 text-(--color-mute)">
            The scoreboard, kept current. Race reports linked where written up.
          </p>
          <ul class="mt-8 divide-y divide-(--color-ink)/10">
            {sortedRecentResults.map((r) => {
              const href = resultHref(r);
              const isExternal = !r.raceReport && !!r.externalUrl;
              const meta = [r.event, r.crewLabel].filter(Boolean).join(' · ');
              const rowInner = (
                <>
                  <span class="font-mono text-xs uppercase tracking-wide text-(--color-mute) pt-1">
                    {formatResultDate(r.date)}
                  </span>
                  <div>
                    <p class="font-medium leading-snug">
                      {r.regatta}
                      <span class="text-(--color-gold)"> · {r.finish}</span>
                    </p>
                    {meta && <p class="mt-1 text-sm text-(--color-mute)">{meta}</p>}
                    {href && (
                      <p class="mt-1 text-sm">
                        <span class="text-(--color-avon) underline-offset-2 group-hover:underline">
                          {r.raceReport ? 'Read race report' : 'Results page'}
                          <span aria-hidden="true"> →</span>
                        </span>
                      </p>
                    )}
                  </div>
                </>
              );
              return (
                <li class="py-4">
                  {href ? (
                    <a
                      href={href}
                      class="group grid grid-cols-[6rem_1fr] gap-4 items-start no-underline"
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                    >
                      {rowInner}
                    </a>
                  ) : (
                    <div class="grid grid-cols-[6rem_1fr] gap-4 items-start">{rowInner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </Container>
      </Section>
    )
  }

  {/* Recent achievements */}
  {
    sortedAchievements.length > 0 && (
      <Section spacing="md">
        <Container width="narrow">
          <Eyebrow>Recent form</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">On the result sheet.</h2>
          <ul class="mt-8 divide-y divide-(--color-ink)/10">
            {sortedAchievements.map((a) => (
              <li class="py-4 grid grid-cols-[5rem_1fr] gap-4 items-start">
                <span class="font-display text-2xl tabular-nums text-(--color-gold)">{a.year}</span>
                <div>
                  <p class="font-medium">{a.title}</p>
                  {a.detail && <p class="mt-1 text-sm text-(--color-mute)">{a.detail}</p>}
                </div>
              </li>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }

  {/* Photo gallery */}
  {
    data?.photos && data.photos.length > 0 && (
      <Section tone="bone" spacing="md">
        <Container>
          <Eyebrow>Squad gallery</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">
            {data.galleryHeading ?? 'The season so far.'}
          </h2>
          {data.galleryIntro && (
            <p class="mt-4 max-w-2xl text-(--color-mute) leading-relaxed">{data.galleryIntro}</p>
          )}
          <div class="mt-10">
            <PhotoGallery images={data.photos} />
          </div>
        </Container>
      </Section>
    )
  }

  {/* CTA strip */}
  <Section tone="navy" spacing="md">
    <Container>
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
        <div class="max-w-xl">
          <Eyebrow tone="paper">Ready to step in?</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl text-(--color-paper)">
            Trials run every September and January.
          </h2>
          <p class="mt-4 text-(--color-paper)/80">
            All experience levels welcome. Drop your details and the captains will be in touch.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/squads/trial/" variant="gold" size="lg">Trial with us</Button>
          {
            data?.contactEmail && (
              <Button
                href={`mailto:${data.contactEmail}`}
                variant="ghost"
                size="lg"
                external
                class="!border-(--color-paper) !text-(--color-paper) hover:!bg-(--color-paper) hover:!text-(--color-ink)"
              >
                {emailCaptainLabel}
              </Button>
            )
          }
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
