---
/**
 * Trial form — Formspree-backed.
 *
 * Flow:
 *   1. User fills the form.
 *   2. `fetch` POSTs to https://formspree.io/f/{FORM_ID}, JSON, AJAX.
 *   3. On 200, the form is replaced by a success state. On error, an inline
 *      message appears below the submit button.
 *
 * The form ID lives in `PUBLIC_FORMSPREE_TRIAL_ID` (anything `PUBLIC_*` is
 * exposed to the client bundle). If unset, the form renders in "disabled"
 * mode with a clear setup notice — so unconfigured deploys don't pretend to
 * accept submissions.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import Field from '../../components/form/Field.astro';
import Textarea from '../../components/form/Textarea.astro';
import RadioGroup from '../../components/form/RadioGroup.astro';
import Checkbox from '../../components/form/Checkbox.astro';
import { ogImage } from '../../lib/og/url';
import JsonLd from '../../components/seo/JsonLd.astro';

const formId = import.meta.env.PUBLIC_FORMSPREE_TRIAL_ID;
const isConfigured = Boolean(formId);

// FAQPage JSON-LD — eligible for Google's FAQ rich result on the trial page.
// Answers lifted verbatim from the page copy so they stay in sync with what
// prospective rowers actually see.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'When are BUBC trials?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'BUBC runs two intakes a year — September for incoming students (the main fresher intake) and a second intake in January. You can also join the club partway through the year; just let us know your availability in the trial form.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need any rowing experience to trial?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No — both first-time rowers and athletes with previous experience are welcome. The novice programme teaches you to row from scratch in your first term.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does the BUBC trial involve?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A technical assessment on the water or an ergometer, a 100-metre swim test in the university pool (a safety protocol, not an intensity test), and a short conversation with the captains and head coach. The whole thing typically takes about an hour.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where does BUBC row?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "From a boathouse on the River Avon between Bath and Saltford, with land training at the University's Sports Training Village on campus.",
      },
    },
    {
      '@type': 'Question',
      name: 'How do I contact the novice programme?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Email novice@bubc.co.uk for novice-specific questions, or info@bubc.co.uk for general enquiries.',
      },
    },
  ],
};
---

<PageLayout
  seo={{
    title: 'Trial with us',
    description:
      'Trial for the University of Bath Boat Club. Open to all Bath students. September and January intakes.',
    image: ogImage({ kind: 'page', slug: 'trial' }),
  }}
>
  <JsonLd data={faqJsonLd} slot="head" />
  <Section spacing="lg">
    <Container width="narrow">
      <Eyebrow>Sign up</Eyebrow>
      <h1 class="mt-4 text-4xl sm:text-5xl">Trial with us.</h1>
      <p class="mt-6 text-lg text-(--color-mute)">
        Whether you rowed at school or have never sat in a boat, we want to hear from you. Drop your
        details below and we'll be in touch with your trial date, what to bring, and where to meet.
        These dates are not strict, you can come and join the boat club partway through the year,
        just let us know your availability in the form and we'll do our best to accommodate.
      </p>

      <div class="mt-10 p-5 sm:p-6 border-l-2 border-(--color-gold) bg-(--color-bone)">
        <h2 class="font-display text-xl">What to expect</h2>
        <ul class="mt-3 space-y-1.5 text-sm text-(--color-ink) list-disc pl-5">
          <li>Technical assessment on the water or an ergo</li>
          <li>A 100-metre swim test in the university pool (safety protocol, not intense)</li>
          <li>A short chat with the captains and head coach</li>
          <li>Around 60 minutes start to finish</li>
        </ul>
      </div>

      {
        !isConfigured && (
          <div
            role="alert"
            class="mt-8 p-4 border border-(--color-blade)/30 bg-(--color-blade)/10 text-sm"
          >
            <strong>Form not yet configured.</strong> Set{' '}
            <code class="font-mono text-xs">PUBLIC_FORMSPREE_TRIAL_ID</code> in
            <code class="font-mono text-xs">apps/web/.env</code> (locally) and as a Vercel
            environment variable. Then redeploy.
          </div>
        )
      }

      <form
        id="trial-form"
        class="mt-10 flex flex-col gap-6"
        method="POST"
        action={isConfigured ? `https://formspree.io/f/${formId}` : undefined}
        data-formspree={isConfigured ? 'true' : 'false'}
        novalidate
      >
        <div class="grid sm:grid-cols-2 gap-5">
          <Field name="firstName" label="First name" required autocomplete="given-name" />
          <Field name="lastName" label="Last name" required autocomplete="family-name" />
        </div>
        <Field
          name="email"
          type="email"
          label="Bath email address"
          required
          autocomplete="email"
          hint="Use your @bath.ac.uk email if you have one."
          inputmode="email"
        />
        <Field name="phone" type="tel" label="Mobile" required autocomplete="tel" inputmode="tel" />
        <Field
          name="course"
          label="Course & year"
          required
          hint="e.g. Mechanical Engineering, 2nd year."
        />

        <RadioGroup
          name="intake"
          legend="Which intake?"
          required
          options={[
            {
              value: 'september',
              label: 'September (Fresher)',
              description: 'Main intake — bedding in or learn-to-row before head races begin.',
            },
            {
              value: 'january',
              label: 'January (Second intake)',
              description: 'Shorter on-water programme, focused on gearing up for regatta season.',
            },
            { value: 'unsure', label: 'Not sure yet' },
          ]}
        />

        <RadioGroup
          name="experience"
          legend="Rowing experience"
          required
          options={[
            { value: 'none', label: 'None at all' },
            { value: 'school', label: 'School / club rowing' },
            { value: 'gb', label: 'GB / national pathway' },
            { value: 'other', label: 'Other (tell us below)' },
          ]}
        />

        {
          /*
          Only relevant to applicants who have rowed before — it picks which
          captain is copied on the application. Hidden by script until they
          select prior experience. Rendered visible and answerable without
          JavaScript, where "Prefer not to say" keeps a novice from being
          blocked by a question that doesn't apply to them.
        */
        }
        <div id="squad-field">
          <RadioGroup
            name="squad"
            legend="Which squad would you be looking to compete with?"
            required
            options={[
              { value: 'mens', label: "Men's squad" },
              { value: 'womens', label: "Women's squad" },
              { value: 'unspecified', label: 'Prefer not to say' },
            ]}
          />
        </div>

        <div class="grid sm:grid-cols-3 gap-5">
          <Field
            name="height"
            type="number"
            label="Height (cm)"
            min={140}
            max={220}
            inputmode="numeric"
          />
          <Field
            name="weight"
            type="number"
            label="Weight (kg)"
            min={40}
            max={140}
            inputmode="numeric"
          />
          <Field
            name="pb2k"
            label="2k erg PB"
            placeholder="e.g. 6:42.0"
            hint="Leave blank if unsure."
          />
        </div>

        <Textarea
          name="message"
          label="Anything else we should know?"
          rows={4}
          maxlength={1000}
          hint="Injuries, accessibility needs, questions — anything."
        />

        <Checkbox
          name="welfare"
          required
          label="I confirm I have read the welfare and safeguarding policy"
          hint="By signing up you agree to our code of conduct (linked from the welfare page)."
        />

        {/* Anti-spam honeypot — bots fill this; humans don't see it. */}
        <div aria-hidden="true" class="hidden">
          <label
            >Don't fill this in <input
              type="text"
              name="_gotcha"
              tabindex="-1"
              autocomplete="off"
            /></label
          >
        </div>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <Button type="submit" variant="gold" size="lg">Send my application</Button>
          <p
            id="trial-form-status"
            class="text-sm text-(--color-mute)"
            role="status"
            aria-live="polite"
          >
          </p>
        </div>
      </form>

      <div
        id="trial-success"
        class="mt-10 hidden p-6 sm:p-8 border-l-2 border-(--color-avon) bg-(--color-bone)"
        role="status"
        aria-live="polite"
      >
        <h2 class="font-display text-2xl">Application received.</h2>
        <p class="mt-3 text-(--color-ink)">
          Thanks — the captains will be in touch within 48 hours. Check your inbox (and spam, just
          in case) for confirmation.
        </p>
        <p class="mt-3 text-sm text-(--color-mute)">
          Questions before then? Email <a
            href="mailto:captain.m@bubc.co.uk"
            class="underline decoration-(--color-gold) underline-offset-4">captain.m@bubc.co.uk</a
          >.
        </p>
      </div>
    </Container>
  </Section>
</PageLayout>

<script>
  import { parseTrialForm } from '../../lib/validation';
  import { routeTrialSubmission } from '../../lib/trial-routing';
  import type { TrialExperience, TrialSquad } from '../../lib/trial-routing';

  const form = document.getElementById('trial-form') as HTMLFormElement | null;
  const status = document.getElementById('trial-form-status');
  const success = document.getElementById('trial-success');
  const squadField = document.getElementById('squad-field');

  // Form must be on screen for at least this long before we accept a submit.
  // Real humans take seconds to fill the form; most bots submit instantly.
  // This is a cheap anti-abuse layer that pairs with the honeypot field.
  const MIN_FILL_TIME_MS = 2000;
  const formMountedAt = performance.now();

  if (form && status && success) {
    const isFormspree = form.dataset.formspree === 'true';

    // Progressive disclosure for the squad question. The markup ships visible
    // and `required` so the form still works with scripting off; here we take
    // over and show it only once prior rowing experience is selected. The
    // `required` attribute has to move with the visibility — a hidden required
    // radio makes `reportValidity()` fail on a control the user cannot see or
    // reach, which is a dead end with no visible error.
    const squadInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="squad"]'));

    const syncSquadField = () => {
      if (!squadField) return;
      const experience = new FormData(form).get('experience');
      const show = typeof experience === 'string' && experience !== 'none';

      squadField.classList.toggle('hidden', !show);
      squadField.toggleAttribute('inert', !show);
      // Only the first radio carries `required`; that is enough to make the
      // whole group required natively.
      if (squadInputs[0]) squadInputs[0].required = show;
      if (!show) squadInputs.forEach((input) => (input.checked = false));
    };

    form.querySelectorAll<HTMLInputElement>('input[name="experience"]').forEach((input) => {
      input.addEventListener('change', syncSquadField);
    });
    syncSquadField();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      status.classList.remove('text-(--color-blade)');

      // Native browser validation first — gives accessible per-field errors.
      if (!form.reportValidity()) return;

      // Anti-bot: too-fast submission.
      if (performance.now() - formMountedAt < MIN_FILL_TIME_MS) {
        status.textContent = 'Please double-check your answers before sending.';
        status.classList.add('text-(--color-blade)');
        return;
      }

      // Zod parse — strict schema validation, normalised + length-checked.
      const data = new FormData(form);
      const parsed = parseTrialForm(data);
      if (!parsed.ok) {
        status.textContent = parsed.errors[0] ?? 'Some fields need checking.';
        status.classList.add('text-(--color-blade)');
        return;
      }

      if (!isFormspree) {
        status.textContent = 'Form is not yet configured — see the notice above.';
        status.classList.add('text-(--color-blade)');
        return;
      }

      // Copy the relevant squad contact. The coaches are the form's target
      // address in Formspree, so they receive every application whether or not
      // this runs — this only adds the second recipient.
      const { cc } = routeTrialSubmission({
        experience: parsed.data.experience as TrialExperience,
        squad: parsed.data.squad as TrialSquad | undefined,
      });
      if (cc) data.set('_cc', cc);

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.classList.add('hidden');
          success.classList.remove('hidden');
          success.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          const json = (await response.json().catch(() => null)) as {
            errors?: { message: string }[];
          } | null;
          status.textContent =
            json?.errors?.[0]?.message ??
            'Something went wrong sending the form. Try again, or email captain.m@bubc.co.uk.';
          status.classList.add('text-(--color-blade)');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send my application';
          }
        }
      } catch {
        status.textContent = 'Network error. Check your connection and try again.';
        status.classList.add('text-(--color-blade)');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send my application';
        }
      }
    });
  }
</script>
