---
/**
 * PageLayout — standard page chrome: BaseLayout + Header + <main> + Footer.
 *
 * Use this for every page except the home page (which gets the hero rendered
 * underneath a transparent header) and the future 404. Pages that need a
 * different shell can compose BaseLayout directly.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SearchDialog from '../components/search/SearchDialog.astro';
import LiveRaceBanner from '../components/layout/LiveRaceBanner.astro';
import { safeFetch } from '../lib/sanity';
import { settingsQuery } from '../lib/queries';
import { validateLiveRaceBanner } from '../lib/validation';
import type { SeoInput } from '../lib/seo';
import type { Settings } from '../lib/types';

interface Props {
  seo?: SeoInput;
  bodyClass?: string;
}

const { seo, bodyClass } = Astro.props;

const settings = await safeFetch<Settings>(settingsQuery);
// Validate the editor-controlled banner payload before we render it. If
// shape or URL protocol is off, we silently skip rendering rather than
// risking a broken or hostile banner.
const banner = validateLiveRaceBanner(settings?.liveRaceBanner);
---

<BaseLayout seo={seo} bodyClass={bodyClass}>
  <slot name="head" slot="head" />
  {banner?.active && <LiveRaceBanner banner={banner} />}
  <Header logo={settings?.logo} />
  <main id="main" data-pagefind-body>
    <slot />
  </main>
  <Footer />
  <SearchDialog />
</BaseLayout>
