---
/**
 * BaseLayout — every page on the site eventually goes through here.
 *
 * Responsibilities:
 *   - Inject <head>: SEO meta, OG tags, canonical URL, favicon, theme color.
 *   - Render the skip-to-main accessibility link.
 *   - Provide a default <body> wrapper with the brand background.
 *   - Slot for page content (the layout itself is chrome-free; PageLayout
 *     wraps this and adds the Header / Footer).
 */
import '../styles/global.css';
import { resolveSeo, SITE, type SeoInput } from '../lib/seo';

interface Props {
  seo?: SeoInput;
  /** Override the <html lang> for translated content if we ever add it. */
  lang?: string;
  /** Optional body class hook (used for hero-overlay pages). */
  bodyClass?: string;
}

const { seo = {}, lang = 'en-GB', bodyClass = '' } = Astro.props;
const meta = resolveSeo(seo, Astro.url);

// Cloudflare Web Analytics — only render the beacon if the token is set so we
// don't ship the script on local/dev builds. Set PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN
// in Vercel after creating a "Web Analytics" site at <https://dash.cloudflare.com>.
const cfAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;

// Sentry — only mount the client init script when a DSN is set so the dep
// gets tree-shaken away on unconfigured deploys. See lib/sentry.ts.
const sentryEnabled = !!import.meta.env.PUBLIC_SENTRY_DSN;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0E2A47" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />

    {meta.noIndex && <meta name="robots" content="noindex,nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content={meta.type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={new URL(meta.image, SITE.url).toString()} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.imageAlt} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:locale" content="en_GB" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:url" content={meta.canonical} />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={new URL(meta.image, SITE.url).toString()} />
    <meta name="twitter:image:alt" content={meta.imageAlt} />

    {/* Favicons + PWA manifest */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* RSS — wired up in Phase 4 */}
    <link rel="alternate" type="application/rss+xml" title="BUBC News" href="/news/rss.xml" />

    {/* Organization + WebSite — single source of truth for the brand entity. */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'SportsOrganization',
            '@id': `${SITE.url}/#organization`,
            name: SITE.name,
            alternateName: SITE.shortName,
            url: SITE.url,
            sport: 'Rowing',
            description: SITE.defaultDescription,
            logo: new URL('/favicon.svg', SITE.url).toString(),
            foundingDate: '1966',
            address: {
              '@type': 'PostalAddress',
              addressLocality: 'Bath',
              addressRegion: 'Somerset',
              addressCountry: 'GB',
            },
            areaServed: { '@type': 'Country', name: 'United Kingdom' },
            parentOrganization: {
              '@type': 'CollegeOrUniversity',
              name: 'University of Bath',
              url: 'https://www.bath.ac.uk/',
            },
            memberOf: {
              '@type': 'SportsOrganization',
              name: 'British Rowing',
              url: 'https://www.britishrowing.org/',
            },
            contactPoint: {
              '@type': 'ContactPoint',
              contactType: 'general enquiries',
              email: 'info@bubc.co.uk',
            },
            sameAs: [
              'https://www.instagram.com/crewbath_/',
              'https://www.youtube.com/@bubc',
              'https://www.strava.com/clubs/bubc',
            ],
          },
          {
            '@type': 'WebSite',
            '@id': `${SITE.url}/#website`,
            url: SITE.url,
            name: SITE.name,
            publisher: { '@id': `${SITE.url}/#organization` },
            inLanguage: 'en-GB',
          },
        ],
      })}
    />

    <slot name="head" />
  </head>
  <body class={`min-h-screen bg-(--color-paper) text-(--color-ink) font-body ${bodyClass}`}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />

    {
      cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
        />
      )
    }

    {sentryEnabled && <script>import {initSentry} from '../lib/sentry'; initSentry();</script>}
  </body>
</html>
